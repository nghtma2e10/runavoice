<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RunaVoice_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RunaVoice_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RUNA"
    mc:Ignorable="d">

    <Grid Background="#04030A">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ÖZEL BAŞLIK ÇUBUĞU (p2p-ana-sayfa.png İLE BİREBİR AYNI TASARIM & HİZALAMA) -->
        <!-- ========================================================================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#05040B" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" SizeChanged="AppTitleBar_SizeChanged">

            <!-- Arka Plan Pencere Sürükleme Bölgesi -->
            <Border x:Name="TitleBarDragArea" Background="Transparent" />

            <!-- SOL: RUNA Marka Yazısı ve BETA Rozeti (Madde 7) -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                <TextBlock Text="RUNA" FontSize="12" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" CharacterSpacing="150" />
                <Border x:Name="BadgeBeta" CornerRadius="5" Padding="6,1" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#66FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8B5CF6" Offset="0.0" />
                            <GradientStop Color="#EC4899" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="BETA" FontSize="9.5" FontWeight="ExtraBold" CharacterSpacing="120" Foreground="White" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- TAM ORTA: Modern Oda Kodu Kutusu (Madde 8) -->
            <Border x:Name="RoomCodeBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#22FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="10,0,4,0" Height="28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0.0" />
                        <GradientStop Color="#08FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Durum Noktası -->
                    <Grid Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse x:Name="TitleBarStatusHalo" Width="10" Height="10" Fill="#2094A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="TitleBarStatusDot" Width="5.5" Height="5.5" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="ODA" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="60" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="#26FFFFFF" Margin="1,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTitleBarRoomCode" Text="Lobi" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                    <!-- SADECE SESLİ ODADAYKEN AÇILAN KOPYALA VE SABİTLE BUTONLARI -->
                    <Button x:Name="BtnTitleBarCopy" Style="{StaticResource RunaCleanButtonStyle}"
                            Visibility="Collapsed" Height="22" Padding="7,0" CornerRadius="6" Margin="4,0,0,0"
                            Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                            ToolTipService.ToolTip="Oda Kodunu Kopyala" Click="BtnTitleBarCopy_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="IconCopyNormal" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M9,9 H20 A2,2 0 0,1 22,11 V20 A2,2 0 0,1 20,22 H9 A2,2 0 0,1 7,20 V11 A2,2 0 0,1 9,9 Z M5,15 H4 A2,2 0 0,1 2,13 V4 A2,2 0 0,1 4,2 H13 A2,2 0 0,1 15,4 V5" />
                                    <Path x:Name="IconCopyCheck" Visibility="Collapsed" Stroke="#86EFAC" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,12 L9,17 L20,6" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtCopyBtnLabel" Text="Kopyala" FontSize="10.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTitleBarPin" Style="{StaticResource RunaCleanButtonStyle}"
                            Visibility="Collapsed" Height="22" Padding="7,0" CornerRadius="6"
                            Background="#19FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                            ToolTipService.ToolTip="Bu odayı kalıcı odalarıma sabitle / kaldır" Click="BtnTitleBarPin_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPinIcon" Text="☆" FontSize="11" Foreground="#FBBF24" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtPinLabel" Text="Sabitle" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- SAĞ: AYARLAR ÇARK İKONU (Sistem Pencere Kontrollerinin Solunda) -->
            <StackPanel x:Name="RightTitleBarTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0">
                <Button x:Name="BtnTitleBarSettings" Style="{StaticResource RunaCleanButtonStyle}"
                        Width="28" Height="28" CornerRadius="7" Background="Transparent"
                        PointerEntered="BtnTitleBarSettings_PointerEntered"
                        PointerExited="BtnTitleBarSettings_PointerExited"
                        ToolTipService.ToolTip="Ayarlar" Click="BtnTitleBarSettings_Click">
                    <Viewbox Width="14.5" Height="14.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Ellipse x:Name="TitleSettingsGearInner" Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="#94A3B8" StrokeThickness="2" />
                            <Path x:Name="TitleSettingsGearOuter" Stroke="#94A3B8" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M19.4,15 A1.65,1.65 0 0,0 19.73,16.82 L19.79,16.88 A2,2 0 1,1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0,0 15.08,19.32 A1.65,1.65 0 0,0 14,20.83 V21 A2,2 0 0,1 10,21 V20.91 A1.65,1.65 0 0,0 8.92,19.4 A1.65,1.65 0 0,0 7.1,19.73 L7.04,19.79 A2,2 0 1,1 4.21,16.96 L4.27,16.9 A1.65,1.65 0 0,0 4.6,15.08 A1.65,1.65 0 0,0 3.09,14 H3 A2,2 0 0,1 3,10 H3.09 A1.65,1.65 0 0,0 4.6,8.92 A1.65,1.65 0 0,0 4.27,7.1 L4.21,7.04 A2,2 0 1,1 7.04,4.21 L7.1,4.27 A1.65,1.65 0 0,0 8.92,4.6 H9 A1.65,1.65 0 0,0 10,3.09 V3 A2,2 0 0,1 14,3 V3.09 A1.65,1.65 0 0,0 15,4.6 A1.65,1.65 0 0,0 16.82,4.27 L16.88,4.21 A2,2 0 1,1 19.71,7.04 L19.65,7.1 A1.65,1.65 0 0,0 19.32,8.92 V9 A1.65,1.65 0 0,0 20.83,10 H21 A2,2 0 0,1 21,14 H20.91 A1.65,1.65 0 0,0 19.4,15 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
