                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- EKRAN ÜSTÜ ÇİZİM BÖLÜMÜ -->
                                    <StackPanel x:Name="SecStreamAnnotations" Spacing="12">
