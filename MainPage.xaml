                                                    </StackPanel>
                                                    <Slider x:Name="SliderNoiseLevel" Grid.Column="1" Minimum="1" Maximum="5" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" Value="3" ValueChanged="SliderNoiseLevel_ValueChanged" Width="260" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Gelişmiş Koruma Expander -->
                                                <Expander Header="Gelişmiş koruma" HorizontalAlignment="Stretch" IsExpanded="False" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" CornerRadius="8">
                                                    <StackPanel Spacing="6" Padding="6,10">
                                                        <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource SetCardRowTitle}" FontSize="12.5" Text="🎧 Kulaklık Akustik Yankı Koruması (AEC)" />
                                                                <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Hoparlörden mikrofona geri dönen yankıyı bastırır" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="TglHeadphoneAec" Grid.Column="1" Style="{StaticResource SetSwitch}" IsOn="True" Toggled="TglAudioOption_Toggled" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Border Style="{StaticResource SetCardRowDivider}" />
                                                        <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource SetCardRowTitle}" FontSize="12.5" Text="🛡️ Darbe, Klavye ve Nefes Kalkanı" />
                                                                <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Ani klavye vuruşlarını ve masa çarpmalarını yumuşatır" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="TglImpactGuard" Grid.Column="1" Style="{StaticResource SetSwitch}" IsOn="True" Toggled="TglAudioOption_Toggled" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bölüm 3: Ses Profili -->
                                    <StackPanel x:Name="SecVoiceProfile" Spacing="10">
