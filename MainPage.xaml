                                                            <Slider x:Name="SlEq80" Orientation="Vertical" Height="110" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="-2" ValueChanged="SliderEqBand_ValueChanged" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtEq80" Text="80 Hz&#x0a;-2.0 dB" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                                        </StackPanel>
                                                        <!-- 300 Hz -->
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6">
                                                            <Slider x:Name="SlEq300" Orientation="Vertical" Height="110" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="-1" ValueChanged="SliderEqBand_ValueChanged" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtEq300" Text="300 Hz&#x0a;-1.0 dB" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                                        </StackPanel>
                                                        <!-- 1 kHz -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                                                            <Slider x:Name="SlEq1k" Orientation="Vertical" Height="110" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="1.5" ValueChanged="SliderEqBand_ValueChanged" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtEq1k" Text="1 kHz&#x0a;+1.5 dB" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
