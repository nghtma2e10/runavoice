                                                        <Button Grid.Column="4" Style="{StaticResource SetPill}" Content="⚖️ Doğal Saf" Tag="flat" Click="BtnEqPreset_Click" />
                                                    </Grid>
                                                </Border>

                                                <!-- Kulak Koruyucu Ses Tavanı -->
                                                <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
