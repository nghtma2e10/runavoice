                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SetCardRowDivider}" />

                                                <!-- Model -->
                                                <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="✨ Model" />
                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Yapay zekâ tabanlı gürültü filtreleme motoru" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbNoiseEngine" Grid.Column="1" Width="260" CornerRadius="6" SelectionChanged="CmbNoiseEngine_SelectionChanged" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="✨ Mozilla RNNoise AI (Önerilen)" Tag="rnnoise" />
                                                        <ComboBoxItem Content="🧠 Derin Hibrit AI + Spektral Kapı" Tag="deep" />
                                                        <ComboBoxItem Content="⚡ Hafif DSP Gürültü Azaltma" Tag="speex" />
                                                        <ComboBoxItem Content="⭕ Kapalı (Saf Stüdyo Sesi)" Tag="off" />
                                                    </ComboBox>
                                                </Grid>
                                                <Border Style="{StaticResource SetCardRowDivider}" />

                                                <!-- Bastırma Şiddeti -->
                                                <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="🎛️ Bastırma Şiddeti" />
