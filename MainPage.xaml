                                    <StackPanel x:Name="SecVoiceNoise" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Gürültü Engelleme" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPlainCard}" Padding="16,10">
                                            <StackPanel Spacing="10">
                                                <!-- Kart Başlığı & Rozet & Canlı Mini Telemetri -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
