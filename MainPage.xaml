                                                        <ComboBoxItem Content="8 sn (Önerilen)" Tag="8" />
                                                        <ComboBoxItem Content="15 sn" Tag="15" />
                                                        <ComboBoxItem Content="30 sn" Tag="30" />
                                                        <ComboBoxItem Content="Kalıcı (elle temizlenene kadar)" Tag="0" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- 3. Anahtar: Çizen kişinin adını göster -->
                                                <Border Style="{StaticResource SetToggleRow}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource SetRowTitle}" Text="Çizen kişinin adını göster" />
                                                            <TextBlock Style="{StaticResource SetDesc}" Text="Çizgi çizilirken son noktasında çizen katılımcının adını küçük bir rozetle gösterir." Margin="0,2,0,0" />
                                                        </StackPanel>
