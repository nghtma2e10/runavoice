                                                                <ComboBoxItem Content="64 kbps (Standart Ses)" Tag="64" />
                                                                <ComboBoxItem Content="96 kbps (HD Kristal - Önerilen)" Tag="96" />
                                                                <ComboBoxItem Content="128 kbps (Stüdyo Kalitesi)" Tag="128" />
                                                                <ComboBoxItem Content="256 kbps (Maksimum Müzik)" Tag="256" />
                                                            </ComboBox>
                                                        </Grid>
                                                        <Border Style="{StaticResource SetCardRowDivider}" />
                                                        <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource SetCardRowTitle}" FontSize="12.5" Text="Ses Gecikmesi" />
