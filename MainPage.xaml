                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Giriş sinyali hassasiyet çarpanı" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Width="260">
