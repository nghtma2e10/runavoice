                                                <Border Style="{StaticResource SetInset}" Padding="12,8">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtVoiceLevelingLiveEmpty" Text="Odaya katıldığınızda katılımcıların dengeleme durumu burada görünür." FontSize="11" Foreground="#94A3B8" />
                                                        <StackPanel x:Name="ListVoiceLevelingPeers" Spacing="4" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bölüm 5: Giriş Modu -->
                                    <StackPanel x:Name="SecVoiceInput" Spacing="10">
