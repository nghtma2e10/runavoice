                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Giriş Modu" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPlainCard}" Padding="16,10">
                                            <StackPanel Spacing="10">
                                                <!-- Giriş Modu -->
                                                <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="🎙️ Giriş Modu" />
                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Ses etkinliği (VAD) veya bas-konuş seçimi" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbInputMode" Grid.Column="1" Width="260" CornerRadius="6" SelectionChanged="CmbInputMode_SelectionChanged" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="🎙️ Ses Etkinliği (VAD)" Tag="vad" />
