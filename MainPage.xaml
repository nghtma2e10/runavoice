                                                    <StackPanel VerticalAlignment="Center" MaxWidth="560">
                                                        <TextBlock Style="{StaticResource SetPanelTitle}" Text="Canlı Ekran Üstü Çizim (Annotation)" />
                                                        <TextBlock Style="{StaticResource SetPanelSub}" Text="İzleyicilerin ekranınızın üzerine fare veya kalemle serbest çizim yapmasına izin verin." />
                                                    </StackPanel>
