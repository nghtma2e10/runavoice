                                                    </Grid>
                                                </Border>

                                                <!-- 4. Bilgi metni -->
                                                <Border Background="#0AFFFFFF" CornerRadius="9" Padding="12,9">
                                                    <TextBlock Style="{StaticResource SetDesc}" Foreground="#CBD5E1" Text="Çizimler yalnızca sizin ekranınızda ve izleyicilerde görünür; yayın görüntüsüne eklenmez." />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ======================= AĞ VE BAĞLANTI ======================= -->
                                <StackPanel x:Name="PaneSettingsNetwork" Spacing="28" Visibility="Collapsed">
                                    <StackPanel x:Name="SecNetStatus" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="P2P Sinyalleşme ve Ağ Durumu" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPanel}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Border Style="{StaticResource SetIconTile}"><TextBlock Style="{StaticResource SetIconTileText}" Text="📡" /></Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource SetPanelTitle}" Text="Bağlantı Durumu" />
                                                            <TextBlock Style="{StaticResource SetPanelSub}" Text="MQTT sinyalleşme havuzu ve WebRTC ICE yapılandırması." />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource SetBadge}" HorizontalAlignment="Right">
                                                        <TextBlock Style="{StaticResource SetBadgeText}" Text="DTLS-SRTP ŞİFRELİ" />
                                                    </Border>
                                                </Grid>
                                                <Border Style="{StaticResource SetInset}">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock x:Name="TxtNetworkBrokerStatus" Text="Aktif Broker: wss://broker.emqx.io:8084/mqtt (Yedekli Havuz)" FontSize="12.5" Foreground="#86EFAC" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSessionIdInfo" Text="Oturum Kimliği: -" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="STUN Sunucuları: Google STUN + Cloudflare STUN (DTLS-SRTP Şifreli Ses &amp; Görüntü)" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ======================= KISAYOLLAR ======================= -->
                                <StackPanel x:Name="PaneSettingsHotkeys" Spacing="28" Visibility="Collapsed">
                                    <StackPanel x:Name="SecHotkeyList" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Klavye Kısayolları" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetHotkeyRow}">
                                            <Grid>
                                                <TextBlock Text="Mikrofon Aç / Kapat" FontSize="13.5" Foreground="#DBDEE1" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SetKbd}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource SetKbdText}" Text="Ctrl + Shift + M" /></Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetHotkeyRow}">
                                            <Grid>
                                                <TextBlock Text="Kulaklık Sustur / Aç" FontSize="13.5" Foreground="#DBDEE1" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SetKbd}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource SetKbdText}" Text="Ctrl + Shift + D" /></Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetHotkeyRow}">
                                            <Grid>
                                                <TextBlock Text="Canlı Yayını Tam Ekran Yap" FontSize="13.5" Foreground="#DBDEE1" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SetKbd}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource SetKbdText}" Text="F11 / Çift Tık" /></Border>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetHotkeyRow}">
                                            <Grid>
                                                <TextBlock Text="Tam Ekrandan veya Açık Pencereden Çık" FontSize="13.5" Foreground="#DBDEE1" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SetKbd}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource SetKbdText}" Text="Esc" /></Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Style="{StaticResource SetDesc}" Margin="4,10,0,0" Text="Bas-Konuş (PTT) tuşu, Ses ve Video › Giriş Modu bölümünden değiştirilebilir." />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ======================= GELİŞMİŞ ======================= -->
                                <StackPanel x:Name="PaneSettingsAdvanced" Spacing="28" Visibility="Collapsed">
                                    <StackPanel x:Name="SecAdvEngine" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" Glyph="&#xE770;" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Gerçek Zamanlı Motor (Deneysel)" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPlainCard}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SetRowTitle}" Text="Ses ve görüntü motoru" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource SetDesc}" Margin="0,2,0,0" TextWrapping="Wrap" Text="Rust (deneysel) yeni düşük gecikmeli motoru kullanır; C# kararlı motordur. Değişiklik uygulama yeniden başlatılınca geçerli olur." />
                                                </StackPanel>
                                                <ComboBox x:Name="CmbRealtimeEngine" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="CmbRealtimeEngine_SelectionChanged">
                                                    <ComboBoxItem Content="C# (Varsayılan)" Tag="legacy" />
                                                    <ComboBoxItem Content="Rust (Deneysel)" Tag="rust" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetPlainCard}">
                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="TxtActiveEngine" AutomationProperties.AutomationId="TxtActiveEngine" Style="{StaticResource SetRowTitle}" Text="Etkin motor: Hesaplanıyor..." />
                                                <TextBlock x:Name="TxtActiveEngineDetails" Style="{StaticResource SetDesc}" Text="" Visibility="Collapsed" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <Button x:Name="BtnOpenEngineLogDir" Content="📁 Kayıt Klasörünü Aç" Click="BtnOpenEngineLogDir_Click" Height="30" Padding="10,0" FontSize="11" CornerRadius="4" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="SecAdvData" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Önbellek &amp; Yerel Veri" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPlainCard}" BorderBrush="#33EF4444">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SetRowTitle}" Text="Kayıtlı Kalıcı Odalar" />
                                                    <TextBlock Style="{StaticResource SetDesc}" Margin="0,2,0,0" Text="Bu cihazda saklanan tüm kalıcı oda kayıtlarını siler. Bu işlem geri alınamaz." />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}" Content="🗑️ Tümünü Temizle" VerticalAlignment="Center"
                                                        Background="#33EF4444" BorderBrush="#59EF4444" BorderThickness="1" Foreground="#FCA5A5" Height="34" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                                                        CornerRadius="6" Click="BtnClearSavedRooms_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================== -->
        <!-- 8.A 3B UZAMSAL SES PENCERESİ (3D SPATIAL AUDIO RADAR MODAL)            -->
        <!-- ===================================================================== -->
        <Grid x:Name="SpatialAudioModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseSpatialAudio_Tapped">
            <Border x:Name="SpatialAudioModalCard" Width="640" MaxHeight="680" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Tapped="StopPropagation_Tapped">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <!-- Başlık ve Kapat Butonu -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🎧" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="3B Uzamsal Ses" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Katılımcıların sesini çevrenizde konumlandırın. En iyi sonuç için kulaklık kullanın." FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="30" CornerRadius="8" Background="#14FFFFFF" Click="BtnCloseSpatialAudio_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#94A3B8" />
                        </Button>
                    </Grid>

                    <!-- Mono Cihaz Uyarısı (varsa) -->
                    <Border x:Name="PnlSpatialMonoWarning" Grid.Row="1" Visibility="Collapsed" Background="#33F59E0B" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <TextBlock Text="⚠️ Çıkış cihazınız mono (1 kanal); uzamsal ses etkisi tam duyulamaz." FontSize="11.5" Foreground="#FBBF24" FontWeight="SemiBold" />
                    </Border>

                    <!-- Ayarlar Satırları (Anahtarlar ve Seçimler) -->
                    <Border Grid.Row="2" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="TglSpatialAudio" Header="3B Uzamsal Ses" OffContent="Kapalı" OnContent="Açık"
                                          Toggled="TglSpatialAudio_Toggled" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Yerleşim Modu" FontSize="11" Foreground="#94A3B8" />
                                <ComboBox x:Name="CmbSpatialMode" Width="145" CornerRadius="6" SelectionChanged="CmbSpatialMode_SelectionChanged">
                                    <ComboBoxItem Content="🌐 Otomatik (Ön Yay)" Tag="auto" />
                                    <ComboBoxItem Content="🖐️ Elle Konumlandırma" Tag="manual" />
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch x:Name="TglSpatialSpeakerMode" Grid.Column="2" Header="Hoparlör Modu" OffContent="Kulaklık" OnContent="Hoparlör (%50)"
                                          Toggled="TglSpatialSpeakerMode_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 360x360 İnteraktif Radar Canvas -->
                    <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,8">
                        <Border Width="360" Height="360" CornerRadius="180" Background="#080515" BorderBrush="#358B5CF6" BorderThickness="1.5">
                            <Grid>
                                <!-- Sabit Radar Kılavuz Çizgileri -->
                                <Ellipse Width="280" Height="280" Stroke="#2A8B5CF6" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Ellipse Width="140" Height="140" Stroke="#1E8B5CF6" StrokeThickness="1" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Line X1="180" Y1="10" X2="180" Y2="350" Stroke="#12FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                                <Line X1="10" Y1="180" X2="350" Y2="180" Stroke="#12FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                                <Line X1="59.7" Y1="59.7" X2="300.3" Y2="300.3" Stroke="#0AFFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                                <Line X1="300.3" Y1="59.7" X2="59.7" Y2="300.3" Stroke="#0AFFFFFF" StrokeThickness="1" IsHitTestVisible="False" />

                                <TextBlock Text="▲ ÖN (0°)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="▼ ARKA (180°)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" IsHitTestVisible="False" />
                                <TextBlock Text="SOL (-90°)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="SAĞ (+90°)" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />

                                <!-- Dinamik Radar Katmanı (Avatarlar ve Etkileşim) -->
                                <Canvas x:Name="CanvasSpatialRadar" Width="360" Height="360" Background="Transparent"
                                        PointerPressed="CanvasSpatialRadar_PointerPressed"
                                        PointerMoved="CanvasSpatialRadar_PointerMoved"
                                        PointerReleased="CanvasSpatialRadar_PointerReleased" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Seçili Katılımcı ve Test Kontrolleri -->
                    <Border Grid.Row="4" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,6,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Spacing="2" MinWidth="130">
                                <TextBlock x:Name="TxtSpatialSelectedUser" Text="Katılımcı Seçin" FontSize="13" FontWeight="Bold" Foreground="#EDE9FE" />
                                <TextBlock x:Name="TxtSpatialAngleInfo" Text="Yön: 0° (Ön)" FontSize="11" Foreground="#A78BFA" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <Grid>
                                    <TextBlock Text="Uzaklık" FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtSpatialDistanceVal" Text="0.2 m (Yakın)" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SliderSpatialDistance" Minimum="0" Maximum="100" StepFrequency="5" Value="20"
                                        ValueChanged="SliderSpatialDistance_ValueChanged" Height="32" />
                            </StackPanel>

                            <Button x:Name="BtnSpatialTestHear" Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}"
                                    Content="🔊 Buradan Dinle" FontSize="11.5" FontWeight="SemiBold" Height="32" Padding="12,0"
                                    Background="#258B5CF6" Foreground="#EDE9FE" BorderBrush="#408B5CF6" BorderThickness="1" CornerRadius="8"
                                    Click="BtnSpatialTestHear_Click" />
                        </Grid>
                    </Border>

                    <!-- Alt Butonlar -->
                    <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="BtnSpatialResetDefault" Style="{StaticResource RunaCleanButtonStyle}"
                                Content="Varsayılana Sıfırla" FontSize="11.5" Foreground="#94A3B8" Background="Transparent"
                                Click="BtnSpatialResetDefault_Click" />
                        <Button x:Name="BtnSpatialClose" Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}"
                                Content="Kapat" FontSize="12.5" FontWeight="SemiBold" Height="34" Width="90" CornerRadius="8"
                                Background="#8B5CF6" Foreground="White"
                                Click="BtnSpatialClose_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================== -->
        <!-- 8.B ODADAN AYRILMA ONAY PENCERESİ (LEAVE ROOM CONFIRM MODAL)           -->
        <!-- ===================================================================== -->
        <Grid x:Name="LeaveRoomConfirmOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseLeaveConfirm_Tapped">
            <Border x:Name="LeaveRoomConfirmCard" Width="440" CornerRadius="20" Background="#0E0B1D" BorderBrush="#33FF5C6E" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="StopPropagation_Tapped">
                <Grid>
                    <!-- Üstte 3 px kırmızı→mor ince degrade şerit -->
                    <Border Height="3" CornerRadius="20,20,0,0" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF5C6E" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Padding="28" Spacing="18">
                        <!-- Üst: 64 px daire (arka #26FF5C6E, dış hale halkası) içinde çıkış ikonu; giriş animasyonunda ikon hafif sallanır -->
                        <Border Width="76" Height="76" CornerRadius="38" Background="#14FF5C6E" BorderBrush="#26FF5C6E" BorderThickness="1" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#26FF5C6E" BorderBrush="#40FF5C6E" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox x:Name="IconLeaveRoomExit" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#FF5C6E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9" />
                                        <Path Stroke="#FF5C6E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M16,17 L21,12 L16,7 M21,12 H9" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Border>

                        <!-- Başlık & Açıklama -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Odadan ayrılmak istiyor musun?" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />

                            <!-- Küçük oda kodu çipi -->
                            <Border Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#8B5CF6" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLeaveRoomCodeChip" Text="RUNA-XXXX" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLeaveRoomTitleText" Text="Oda Başlığı" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtLeaveRoomDesc" Text="Sesli bağlantınız sonlanacak." FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Yayın açıksa uyarı satırı: sarı ikonlu, yuvarlatılmış kutu (#1AF59E0B arka plan) -->
                        <Border x:Name="LeaveRoomStreamWarningBox" Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="10" Padding="12,9" HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="#F59E0B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M8,2 L14.5,13.5 H1.5 Z M8,6 V9 M8,11.5 H8.01" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Ekran paylaşımın da durdurulacak" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Butonlar: tam genişlik iki sütun, aralık 12, yükseklik 44, köşe 12, HorizontalAlignment="Stretch", içerik ortalı (ikon + metin, aralık 8) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                            <!-- Vazgeç — sol; ikon: geri ok veya çarpı; şeffaf zemin, kenarlık #33FFFFFF ; varsayılan odak ve Esc tuşu -->
                            <Button x:Name="BtnCancelLeaveRoom" Grid.Column="0" Style="{StaticResource RunaCleanButtonStyle}"
                                    Height="44" CornerRadius="12" HorizontalAlignment="Stretch"
                                    Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Foreground="#F1F5F9" FontSize="13" FontWeight="SemiBold"
                                    Click="BtnCancelLeaveRoom_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <Canvas Width="16" Height="16">
                                            <Path Stroke="#F1F5F9" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M12,4 L4,12 M4,4 L12,12" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Vazgeç" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Odadan Ayrıl — sağ; ikon: çıkış (kapıdan ok); arka plan #FF5C6E → #E11D48 degrade, hafif kırmızı gölge; Enter tuşu bunu tetiklemez -->
                            <Button x:Name="BtnConfirmLeaveRoom" Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}"
                                    Height="44" CornerRadius="12" HorizontalAlignment="Stretch"
                                    BorderThickness="0"
                                    Foreground="White" FontSize="13" FontWeight="Bold"
                                    Click="BtnConfirmLeaveRoom_Click"
                                    PreviewKeyDown="BtnConfirmLeaveRoom_PreviewKeyDown"
                                    KeyDown="BtnConfirmLeaveRoom_KeyDown">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF5C6E" Offset="0" />
                                        <GradientStop Color="#E11D48" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9" />
                                            <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M16,17 L21,12 L16,7 M21,12 H9" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Odadan Ayrıl" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 8.B OYUN AKIŞI MODAL PENCERESİ (SUNSHINE & MOONLIGHT)             -->
        <!-- ================================================================= -->
        <Grid x:Name="GameStreamModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseGameStream_Tapped">
            <Border x:Name="GameStreamModalCard" Width="760" Height="620" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Tapped="StopPropagation_Tapped">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <!-- 1. Başlık ve Kapat Butonu -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🎮" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="Oyun Akışı" FontSize="18" FontWeight="Bold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Bilgisayarınızdaki oyunu odadaki bir arkadaşınızla paylaşın." FontSize="12" Foreground="#94A3B8" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock Text="Sunshine (LizardByte) ve Moonlight ile çalışır." FontSize="11" Foreground="#7C3AED" />
                                <HyperlinkButton Content="ℹ️ Üçüncü taraf yazılımlar" Padding="0" FontSize="11" Foreground="#A78BFA" Click="BtnThirdPartyLicenses_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="32" Height="32" CornerRadius="8" Background="#14FFFFFF" Click="BtnCloseGameStream_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#94A3B8" />
                        </Button>
                    </Grid>

                    <!-- 2. Durum Kartı (PDF Bölüm 5.1 & 10.2) -->
                    <Border Grid.Row="1" Background="#161226" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Name="TxtGameStreamStatusLine" Text="Yetenekler algılanıyor..." FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TxtGameStreamComponentsLine" Text="Bileşenler kontrol ediliyor..." FontSize="11.5" Foreground="#94A3B8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="BtnInstallSunshine" Content="Sunshine Kur" Style="{StaticResource RunaCleanButtonStyle}"
                                        Background="#8B5CF6" Foreground="White" FontSize="11.5" Height="30" Padding="12,0" CornerRadius="8"
                                        Visibility="Collapsed" Click="BtnInstallSunshine_Click" />
                                <Button x:Name="BtnInstallMoonlight" Content="Moonlight Kur" Style="{StaticResource RunaCleanButtonStyle}"
                                        Background="#3B82F6" Foreground="White" FontSize="11.5" Height="30" Padding="12,0" CornerRadius="8"
                                        Visibility="Collapsed" Click="BtnInstallMoonlight_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Gizlilik Koruması Anahtarı (PDF Bölüm 9.2 & 10.2) -->
                    <Border x:Name="PnlGameStreamPrivacyRow" Grid.Row="2" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="TglGameStreamPrivacyCurtain" Header="🛡️ Oyun dışındaki pencereleri gizle"
                                          OffContent="Kapalı" OnContent="Açık" Toggled="TglGameStreamPrivacyCurtain_Toggled" />
                            <Border x:Name="BadgePrivacyCurtainOff" Grid.Column="1" Visibility="Collapsed" Background="#33F97316" BorderBrush="#F97316" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ Koruma kapalı" Foreground="#FB923C" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 4. Gelen Davet Kartı (Oyuncu için) -->
                    <Border x:Name="CardGameStreamIncomingInvite" Grid.Row="3" Visibility="Collapsed" Background="#23173D" BorderBrush="#A855F7" BorderThickness="1.5" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="TxtInviteTitle" Text="Arkadaşınız sizi oyuna davet ediyor" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" />
                                <TextBlock x:Name="TxtInviteQuality" Text="1080p · 60 FPS · HEVC · ~3,8 Mbps" FontSize="11.5" Foreground="#C084FC" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TxtInvitePrivacyNote" Text="🛡️ Gizlilik koruması aktif" FontSize="11" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TxtInviteTimer" Text="60 sn" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="BtnAcceptInvite" Content="Kabul Et" Style="{StaticResource RunaCleanButtonStyle}"
                                        Background="#10B981" Foreground="White" FontSize="12" FontWeight="SemiBold" Height="34" Padding="14,0" CornerRadius="8"
                                        Click="BtnAcceptInvite_Click" />
                                <Button x:Name="BtnRejectInvite" Content="Reddet" Style="{StaticResource RunaCleanButtonStyle}"
                                        Background="#EF4444" Foreground="White" FontSize="12" FontWeight="SemiBold" Height="34" Padding="14,0" CornerRadius="8"
                                        Click="BtnRejectInvite_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Aktif Canlı Oturum Paneli -->
                    <Border x:Name="CardGameStreamActiveSession" Grid.Row="4" Visibility="Collapsed" Background="#1E1438" BorderBrush="#6366F1" BorderThickness="1.2" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="TxtSessionStepIndicator" Text="Oturum Durumu" FontSize="13" FontWeight="Bold" Foreground="#A5B4FC" />
                                <TextBlock x:Name="TxtSessionTelemetry" Text="Bağlantı: Tünel · Gecikme: -- ms · Hız: -- Mbps · Kayıp: %0.0" FontSize="11.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="TxtSessionHostNotice" Text="Acil durdurma: Ctrl+Alt+End" FontSize="10.5" Foreground="#94A3B8" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="BtnEndSession" Grid.Column="1" Content="Oturumu Bitir" Style="{StaticResource RunaCleanButtonStyle}"
                                    Background="#EF4444" Foreground="White" FontSize="12" FontWeight="Bold" Height="34" Padding="14,0" CornerRadius="8"
                                    Click="BtnEndSession_Click" />
                        </Grid>
                    </Border>

                    <!-- 6. Odadaki Arkadaşlar Listesi -->
                    <Grid Grid.Row="5" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Oyun Akışı Açık Olan Arkadaşlar" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,8" />
                        <Border Grid.Row="1" Background="#07FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
                            <Grid>
                                <TextBlock x:Name="TxtGameStreamEmptyPeers" Text="Davet gönderebilmek için arkadaşınızın da Oyun Akışı penceresini açması gerekir."
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20" />
                                <ListView x:Name="LvGameStreamPeers" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,3">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <!-- Avatar -->
                                                    <PersonPicture Grid.Column="0" DisplayName="{Binding PeerName}" Width="32" Height="32" Margin="0,0,10,0" />
                                                    <!-- İsim ve Durum -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding PeerName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <!-- Yetenek Rozetleri -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Border Visibility="{Binding CanHostVisibility}" Background="#2210B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                            <TextBlock Text="Host ✓" FontSize="10" Foreground="#34D399" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Visibility="{Binding CanPlayVisibility}" Background="#223B82F6" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                            <TextBlock Text="Oynayabilir ✓" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- Davet Gönder Butonu -->
                                                    <Button Grid.Column="3" Content="Davet Gönder" Style="{StaticResource RunaCleanButtonStyle}"
                                                            Background="#8B5CF6" Foreground="White" FontSize="11.5" Height="30" Padding="12,0" CornerRadius="8"
                                                            IsEnabled="{Binding CanInvite}" Click="BtnSendPeerInvite_Click" Tag="{Binding PeerKey}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 8.C OYUN SEÇİM MODAL PENCERESİ (PDF Bölüm 10.3)                   -->
        <!-- ================================================================= -->
        <Grid x:Name="GameSelectModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseGameSelect_Tapped">
            <Border x:Name="GameSelectModalCard" Width="580" Height="540" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Tapped="StopPropagation_Tapped">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TxtGameSelectTitle" Text="Arkadaşınız için oyun seçin" FontSize="16" FontWeight="Bold" Foreground="#F2F3F5" />
                            <TextBlock Text="Sunshine oyun listenizden bir oyun seçin veya yeni bir oyun ekleyin." FontSize="11.5" Foreground="#94A3B8" />
                        </StackPanel>
                        <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="30" Height="30" CornerRadius="8" Background="#14FFFFFF" Click="BtnCancelGameSelect_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#94A3B8" />
                        </Button>
                    </Grid>

                    <!-- Oyun Listesi -->
                    <Border Grid.Row="1" Background="#07FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,0,10">
                        <ListView x:Name="LvSelectableGames" SelectionMode="Single" SelectionChanged="LvSelectableGames_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="🎮" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <TextBlock Text="{Binding ExePath}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Oyun Ekle Butonu -->
                    <Button Grid.Row="2" x:Name="BtnAddCustomGame" Content="+ Oyun Ekle (.exe)" Style="{StaticResource RunaCleanButtonStyle}"
                            Background="#14FFFFFF" Foreground="#A78BFA" FontSize="12" Height="32" CornerRadius="8" HorizontalAlignment="Left"
                            Margin="0,0,0,10" Click="BtnAddCustomGame_Click" />

                    <!-- Kalite ve Uyarı Satırı -->
                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtGameQualitySummary" Text="Kalite: 1080p · 60 FPS · HEVC · ~3,8 Mbps" FontSize="12" FontWeight="SemiBold" Foreground="#C084FC" />
                        <TextBlock Text="⚠️ Oyuncu bilgisayarınızda fare, klavye ve kumanda kontrolüne sahip olur." FontSize="11" Foreground="#F59E0B" />
                    </StackPanel>

                    <!-- Butonlar -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Content="Vazgeç" Style="{StaticResource RunaCleanButtonStyle}"
                                Background="#14FFFFFF" Foreground="White" Height="38" CornerRadius="10" Margin="0,0,6,0"
                                Click="BtnCancelGameSelect_Click" />
                        <Button Grid.Column="1" x:Name="BtnConfirmSendInvite" Content="Daveti Gönder" Style="{StaticResource RunaCleanButtonStyle}"
                                Background="#8B5CF6" Foreground="White" Height="38" CornerRadius="10" Margin="6,0,0,0" FontWeight="Bold"
                                IsEnabled="False" Click="BtnConfirmSendInvite_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 8.D GİZLİLİK PERDESİ KAPATMA UYARISI (PDF Bölüm 9.2 & 10.4)       -->
        <!-- ================================================================= -->
        <Grid x:Name="PrivacyOffWarningOverlay" Background="#D9000000" Visibility="Collapsed" Tapped="BackdropClosePrivacyWarning_Tapped">
            <Border x:Name="PrivacyOffWarningCard" Width="480" CornerRadius="20" Background="#180C1E" BorderBrush="#EF4444" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Tapped="StopPropagation_Tapped">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="Gizlilik korumasını kapatmak riskli" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Kapatırsanız oyuncu Alt+Tab ile masaüstünüzü, açık pencerelerinizi ve bildirimlerinizi görebilir; fare ve klavyeyle bilgisayarınızda işlem yapabilir. Yalnızca tamamen güvendiğiniz biriyle kapatın."
                                   FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <!-- Açık bırak: Varsayılan odak (PDF Bölüm 9.2) -->
                        <Button x:Name="BtnPrivacyKeepOn" Grid.Column="0" Content="Açık bırak" Style="{StaticResource RunaCleanButtonStyle}"
                                Background="#8B5CF6" Foreground="White" Height="38" CornerRadius="10" Margin="0,0,6,0" FontWeight="Bold"
                                Click="BtnPrivacyKeepOn_Click" />
                        <Button x:Name="BtnPrivacyConfirmOff" Grid.Column="1" Content="Yine de kapat" Style="{StaticResource RunaCleanButtonStyle}"
