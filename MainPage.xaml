                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="🔈 Ana Çıkış Sesi" />
                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Genel dinleme ses seviyesi" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Width="260">
                                                        <Slider x:Name="SliderOutputGain" Minimum="0" Maximum="200" Value="100" ValueChanged="SliderOutputGain_ValueChanged" Width="196" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtOutputGainVal" Text="%100" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

