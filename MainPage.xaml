                                                <Grid x:Name="PanelVadThreshold" Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="Açılma Eşiği" />
                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Mikrofonun iletime başlayacağı ses seviyesi" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Width="260">
                                                        <Slider x:Name="SliderVadThreshold" Minimum="-60" Maximum="-15" Value="-45" ValueChanged="SliderVadThreshold_ValueChanged" Width="196" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtVadThreshLabel" Text="-45 dB" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- PTT Tuş Satırı -->
                                                <Grid x:Name="PanelPttKeybind" Visibility="Collapsed" Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource SetCardRowTitle}" Text="Bas-Konuş Tuşu" />
                                                        <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Konuşmak için basılı tutulacak tuş" />
