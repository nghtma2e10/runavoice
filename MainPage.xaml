                                                            Height="32" Width="260" CornerRadius="6" Click="BtnAssignPttKey_Click" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Gelişmiş İletim (Opus) Expander -->
                                                <Expander Header="Gelişmiş iletim (Opus)" HorizontalAlignment="Stretch" IsExpanded="False" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" CornerRadius="8">
                                                    <StackPanel Spacing="6" Padding="6,10">
                                                        <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource SetCardRowTitle}" FontSize="12.5" Text="Ses Kalitesi" />
