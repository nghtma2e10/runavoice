<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RunaVoice_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RunaVoice_WinUI"
    xmlns:models="using:RunaVoice_WinUI.Models"
    xmlns:services="using:RunaVoice_WinUI.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp">

    <Page.Resources>
        <!-- Kozmik Arka Plan Gradyanları (p2p-ana-sayfa.png ile birebir tonlar) -->
        <LinearGradientBrush x:Key="CosmicDeepBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#06040E" Offset="0.0" />
            <GradientStop Color="#04030A" Offset="0.55" />
            <GradientStop Color="#020106" Offset="1.0" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CosmicCenterAuraBrush" Center="0.5,0.36" GradientOrigin="0.5,0.34" RadiusX="0.60" RadiusY="0.56">
            <GradientStop Color="#476B21A8" Offset="0.0" />
            <GradientStop Color="#2B4C1D95" Offset="0.40" />
            <GradientStop Color="#142E1065" Offset="0.72" />
            <GradientStop Color="#0004030A" Offset="1.0" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="HeroMedallionHaloBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#80A855F7" Offset="0.0" />
            <GradientStop Color="#457E22CE" Offset="0.48" />
            <GradientStop Color="#14581C87" Offset="0.78" />
            <GradientStop Color="#00000000" Offset="1.0" />
        </RadialGradientBrush>

        <!-- Ana Sayfa İki Büyük Aksiyon Kartı Fırçaları -->
        <LinearGradientBrush x:Key="HostCardRestBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#73581C87" Offset="0.0" />
            <GradientStop Color="#8C2E1065" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HostCardHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#996B21A8" Offset="0.0" />
            <GradientStop Color="#B33B0764" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="JoinCardRestBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#80172554" Offset="0.0" />
            <GradientStop Color="#990F172A" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="JoinCardHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A61E3A8A" Offset="0.0" />
            <GradientStop Color="#BF172554" Offset="1.0" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="HostLeftIconCircleBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#A855F7" Offset="0.0" />
            <GradientStop Color="#7E22CE" Offset="1.0" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="JoinLeftIconCircleBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3B82F6" Offset="0.0" />
            <GradientStop Color="#1D4ED8" Offset="1.0" />
        </RadialGradientBrush>

        <!-- Modal Birincil Buton Gradyanları (p2p-ana-sayfa-create.png & p2p-ana-sayfa-join.png birebir) -->
        <LinearGradientBrush x:Key="ModalPrimaryHostBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0.0" />
            <GradientStop Color="#6366F1" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ModalPrimaryJoinBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0.0" />
            <GradientStop Color="#4F46E5" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryPurpleBtnBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0.0" />
            <GradientStop Color="#7C3AED" Offset="1.0" />
        </LinearGradientBrush>

        <!-- ===== Modern tasarım dili: cam yüzeyler ===== -->
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#B3100D1E" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#1FFFFFFF" />

        <LinearGradientBrush x:Key="TileGlassBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#CC1A1433" Offset="0.0" />
            <GradientStop Color="#CC0F0B20" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LobbyTopGlowBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#2E7C3AED" Offset="0.0" />
            <GradientStop Color="#127C3AED" Offset="0.5" />
            <GradientStop Color="#00000000" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CoverScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#1A000000" Offset="0.0" />
            <GradientStop Color="#B30A0814" Offset="1.0" />
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="RootScaleContainer" Background="{StaticResource CosmicDeepBackgroundBrush}">

        <!-- ================================================================= -->
        <!-- 0. PÜRÜZSÜZ RADYAL MOR NEBULA HALE KATMANI (p2p-ana-sayfa.png)    -->
        <!-- ================================================================= -->
        <Border Background="{StaticResource CosmicCenterAuraBrush}" IsHitTestVisible="False" />

        <!-- ================================================================= -->
        <!-- 1. LOBİ / ANA SAYFA GÖRÜNÜMÜ (p2p-ana-sayfa.png İLE BİREBİR AYNI) -->
        <!-- ================================================================= -->
        <Grid x:Name="LandingViewGrid" Visibility="Visible">
            <!-- Üstten süzülen yumuşak mor ışık -->
            <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="460"
                    Background="{StaticResource LobbyTopGlowBrush}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1220" Margin="32,32,32,36" VerticalAlignment="Center" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ SOL KOLON: MARKA + AKSİYON KARTLARI ============ -->
                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">

                        <!-- Marka kartı -->
                        <Border CornerRadius="28" Background="{StaticResource GlassPanelBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="28,28,28,24">
                            <StackPanel Spacing="0" HorizontalAlignment="Center">
                                <Grid Width="132" Height="126" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Ellipse x:Name="HeroLogoGlow" Width="190" Height="190" Margin="-30,-32,-30,-32"
                                             Fill="{StaticResource HeroMedallionHaloBrush}" IsHitTestVisible="False"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid x:Name="HeroLogoContainer" Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="HeroRunaLogoBrush" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="112" Height="112" Stroke="#55C084FC" StrokeThickness="1.2" IsHitTestVisible="False"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <Grid HorizontalAlignment="Center">
                                    <TextBlock Text="RUNA" FontFamily="Assets/Fonts/Cinzel.ttf#Cinzel" FontSize="34" FontWeight="ExtraBold"
                                               Foreground="#4DA855F7" CharacterSpacing="260" Margin="5,1,0,0" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBlock Text="RUNA" FontFamily="Assets/Fonts/Cinzel.ttf#Cinzel" FontSize="34" FontWeight="ExtraBold"
                                               CharacterSpacing="260" Margin="4,0,0,0" HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFFFFF" Offset="0.30" />
                                                <GradientStop Color="#C084FC" Offset="0.70" />
                                                <GradientStop Color="#A855F7" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="Yeni nesil sesli sohbet deneyimi" FontSize="13" FontWeight="Medium"
                                           Foreground="#B8A5E8" HorizontalAlignment="Center" Margin="0,8,0,0" />

                                <!-- Özellik çipleri -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Border Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                        <TextBlock Text="P2P" FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                    </Border>
                                    <Border Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                        <TextBlock Text="Düşük gecikme" FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                    </Border>
                                    <Border Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                        <TextBlock Text="Ekran paylaşımı" FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- KART 1: YENİ ODA BAŞLAT -->
                        <Border x:Name="HostHeroCard" Height="92" CornerRadius="24"
                                Background="{StaticResource HostCardRestBrush}"
                                BorderBrush="#59A855F7" BorderThickness="1" Padding="20,0"
                                Tapped="BtnOpenHostDialog_Tapped">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HostCardLeftCircle" Grid.Column="0" Width="50" Height="50" CornerRadius="16"
                                        Background="{StaticResource HostLeftIconCircleBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M12,5 L12,19 M5,12 L19,12" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Yeni Oda Başlat" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Kendi sesli odanı oluştur" FontSize="12" FontWeight="Medium" Foreground="#B3E2E8F0" />
                                </StackPanel>

                                <Border x:Name="HostCardRightArrow" Grid.Column="2" Width="34" Height="34" CornerRadius="17"
                                        Background="#14FFFFFF" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Polyline Points="9,18 15,12 9,6" Stroke="#CCFFFFFF" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 3. SAĞ ÜSTTE SABİT TELEMETRİ PANELİ (Madde 10: Genişlik 320, karartmasız, cam arka plan #D90E0B1D, köşe 14) -->
                        <Border x:Name="PersistentTelemetryPanel"
                                Width="320"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,16,16,0"
                                CornerRadius="14"
                                Background="#D90E0B1D"
                                BorderBrush="#338B5CF6"
                                BorderThickness="1"
                                Padding="14,12"
                                Visibility="Collapsed"
                                Tapped="StopPropagation_Tapped">
                            <StackPanel Spacing="10">
                                <!-- Başlık ve Kapat Butonu -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="#268B5CF6" VerticalAlignment="Center">
                                            <TextBlock Text="📊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="YAYIN TELEMETRİSİ" FontSize="12" FontWeight="ExtraBold" Foreground="#DDD6FE" CharacterSpacing="50" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="BtnClosePersistentTelemetry" Style="{StaticResource RunaCleanButtonStyle}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Width="24" Height="24" CornerRadius="6" Background="Transparent"
                                            Click="BtnClosePersistentTelemetry_Click">
                                        <Viewbox Width="12" Height="12">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!-- Sıkıştırılmış Metrik Satırları -->
                                <StackPanel Spacing="6">
                                    <!-- Satır 1: Kodek & Çözünürlük/FPS -->
                                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="KODEK" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                                <TextBlock x:Name="TxtTelemetryCodec" Text="MJPEG (JPEG kareleri)" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                                <TextBlock Text="ÇÖZÜNÜRLÜK / FPS" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="TxtTelemetryResFps" Text="1920×1080 @ 60 FPS" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Satır 2: Bit Hızı & Gecikme (RTT) -->
                                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="BİT HIZI" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                                <TextBlock x:Name="TxtTelemetryBitrate" Text="4.50 Mbps" FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                                <TextBlock Text="GECİKME (RTT)" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="TxtTelemetryRtt" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="#FDE047" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Satır 3: Paket Kaybı & İşlenen Kare -->
                                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6">
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="PAKET / KARE KAYBI" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                                <TextBlock x:Name="TxtTelemetryLoss" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="#86EFAC" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                                <TextBlock Text="İŞLENEN KARE" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="TxtTelemetryFrames" Text="0 Kare" FontSize="11.5" FontWeight="SemiBold" Foreground="#EDE9FE" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Satır 4: Dinamik Kalite & Karar -->
                                    <Border Background="#14FFFFFF" CornerRadius="8" Padding="10,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="DİNAMİK KALİTE DURUMU" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                            <TextBlock x:Name="TxtTelemetryAdaptiveStep" Text="Dinamik Mod: Hazırlanıyor..." FontSize="11" Foreground="#DDD6FE" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TxtTelemetryAdaptiveDecision" Text="Yayın parametreleri ölçülüyor." FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Alt: Raporu Kopyala Butonu -->
                                <Button x:Name="BtnCopyTelemetryReport" Style="{StaticResource RunaCleanButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="28" CornerRadius="8"
                                        Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        Click="BtnCopyTelemetryReport_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="11" />
                                        <TextBlock Text="Raporu Kopyala" FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- KART 2: ODAYA KATIL -->
                        <Border x:Name="JoinHeroCard" Height="92" CornerRadius="24"
                                Background="{StaticResource JoinCardRestBrush}"
                                BorderBrush="#4D60A5FA" BorderThickness="1" Padding="20,0"
                                Tapped="BtnOpenJoinDialog_Tapped">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="JoinCardLeftCircle" Grid.Column="0" Width="50" Height="50" CornerRadius="16"
                                        Background="{StaticResource JoinLeftIconCircleBrush}" VerticalAlignment="Center">
                                    <Viewbox Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M10,13 A5,5 0 0,0 17.54,13.54 L20.54,10.54 A5,5 0 0,0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0,0 6.46,10.46 L3.46,13.46 A5,5 0 0,0 10.53,20.53 L12.24,18.82" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Odaya Katıl" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="Davet kodu ile katıl" FontSize="12" FontWeight="Medium" Foreground="#B3E2E8F0" />
                                </StackPanel>

                                <Border x:Name="JoinCardRightArrow" Grid.Column="2" Width="34" Height="34" CornerRadius="17"
                                        Background="#14FFFFFF" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Polyline Points="9,18 15,12 9,6" Stroke="#CCFFFFFF" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============ SAĞ KOLON: KALICI ODALAR ============ -->
                    <Border Grid.Column="1" CornerRadius="28" VerticalAlignment="Top" MinHeight="420"
                            Background="{StaticResource GlassPanelBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="24,22,24,24">
                        <StackPanel Spacing="18">
                            <!-- Başlık satırı -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="12" Background="#1AF59E0B" VerticalAlignment="Center">
                                        <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#FBBF24" Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Kalıcı Odalar" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            <Border x:Name="SavedRoomsCountBadge" Visibility="Collapsed" Background="#288B5CF6" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSavedRoomsCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#C4B5FD" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Sık kullandığın ve arkadaşlarınla paylaştığın sabit odalar" FontSize="11.5" Foreground="#8B93A7" />
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="BtnToggleShowAllRooms" Style="{StaticResource RunaCleanButtonStyle}"
                                        Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,6" CornerRadius="14"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="BtnToggleShowAllRooms_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtShowAllRoomsLabel" Text="Tümünü Gör" FontSize="11.5" FontWeight="SemiBold" Foreground="#C4B5FD" VerticalAlignment="Center" />
                                        <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Polyline Points="9,18 15,12 9,6" Stroke="#C4B5FD" StrokeThickness="2.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" />

                            <!-- Boş durum -->
                            <Grid x:Name="EmptyRoomsPlaceholder" MinHeight="250">
                                <Rectangle RadiusX="20" RadiusY="20" Stroke="#1FFFFFFF" StrokeThickness="1" StrokeDashArray="4,4" Fill="#05FFFFFF" />
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#1AF59E0B" HorizontalAlignment="Center">
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#FBBF24" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"
                                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Henüz kayıtlı kalıcı odan yok" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="12" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="320" LineHeight="18">
                                        <Run Text="&quot;Yeni Oda Başlat&quot;" FontWeight="Bold" Foreground="#C4B5FD" /><Run Text=" penceresinden kalıcı oda oluşturabilir veya katıldığın odaları sabitleyebilirsin." Foreground="#8B93A7" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Kayıtlı oda kartları -->
                            <ItemsRepeater x:Name="RoomsRepeater" Visibility="Collapsed">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="200" MinRowSpacing="14" MinColumnSpacing="14" MaximumRowsOrColumns="3" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:PersistentRoom">
                                        <Border CornerRadius="20" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                                Loaded="InteractiveCard_Loaded" Tapped="SavedRoomCard_Tapped" Tag="{x:Bind Code}">
                                            <Grid RowDefinitions="92,Auto">
                                                <!-- Kapak görseli -->
                                                <Border Grid.Row="0" CornerRadius="19,19,0,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind CoverBitmap, Mode=OneWay}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                    <Border Background="{StaticResource CoverScrimBrush}" CornerRadius="19,19,0,0" />
                                                </Border>

                                                <!-- Kaldır (kapak üstü, sağ üst) -->
                                                <Button Grid.Row="0" Style="{StaticResource RunaCleanButtonStyle}" Width="26" Height="26" CornerRadius="13"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                        Background="#8C000000" ToolTipService.ToolTip="Kalıcı Odalardan Kaldır"
                                                        Click="BtnDeletePersistentRoom_Click" Tag="{x:Bind Code}">
                                                    <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Stroke="#E2E8F0" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M18,6 L6,18 M6,6 L18,18" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>

                                                <!-- Alt bilgi -->
                                                <Grid Grid.Row="1" Padding="14,12,12,13" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{x:Bind OnlineDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind OnlineStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind OnlineTextBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}" Width="34" Height="34" CornerRadius="17"
                                                            Background="{StaticResource PrimaryPurpleBtnBrush}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Bu Odaya Katıl" Click="BtnJoinFromCard_Click" Tag="{x:Bind Code}">
                                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24">
                                                                <Polyline Points="9,18 15,12 9,6" Stroke="White" StrokeThickness="2.5"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================= -->
        <!-- 2. SESLİ ODA SAHNESİ (TAM ORTALANMIŞ İKONLAR & PÜRÜZSÜZ GEÇİŞLER) -->
        <!-- ================================================================= -->
        <Grid x:Name="VoiceStageGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VoiceLeftColDef" Width="355" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="VoiceRightColDef" Width="395" />
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: KATILIMCILAR VE GERÇEK PING SİNYAL GÖSTERGESİ -->
            <Border x:Name="VoiceLeftPanel" Grid.Column="0" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="24" Margin="10,10,5,10" Padding="14,16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Üst Başlık Şeridi -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#268B5CF6" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#A855F7"
                                              Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="Katılımcılar" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <Border Background="#208B5CF6" BorderBrush="#408B5CF6" BorderThickness="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtParticipantsCount" Text="(1)" FontSize="12" FontWeight="SemiBold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <Border x:Name="P2PTreeModeBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#26F59E0B" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="8" Padding="7,2">
                            <TextBlock Text="⚡ P2P Ağaç" FontSize="10" FontWeight="Bold" Foreground="#FCD34D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Başlık Altı İnce Ayırıcı Çizgi -->
                    <Border Grid.Row="0" Height="1" Background="#1CFFFFFF" Margin="2,46,2,0" VerticalAlignment="Top" />

                    <!-- Katılımcı Listesi (Tüm Yükseklik Boyunca Kaydırılabilir) -->
                    <ListView x:Name="ParticipantsListView" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource CleanListViewItemStyle}" Margin="0,10,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RoomParticipant">
                                <Border Margin="{x:Bind RowIndentMargin, Mode=OneWay}" Padding="10,8" CornerRadius="16"
                                        Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1"
                                        Loaded="InteractiveCard_Loaded"
                                        Tapped="ParticipantCard_Tapped" RightTapped="ParticipantCard_RightTapped" Tag="{x:Bind}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- P2P Hiyerarşik Röle Ağaç Bağlantısı -->
                                        <TextBlock Grid.Column="0" Text="└" FontSize="14" FontWeight="Bold" Foreground="#FBBF24"
                                                   VerticalAlignment="Center" Visibility="{x:Bind TreeConnectorVisibility, Mode=OneWay}" />

                                        <!-- Dairesel Gerçek Avatar + Konuşma Halkası (Yeşil Durum Noktası Kesinlikle Yok) -->
                                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                                BorderBrush="{x:Bind SpeakingRingBrush, Mode=OneWay}" BorderThickness="2" VerticalAlignment="Center">
                                            <Ellipse Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind AvatarBitmap, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Border>

                                        <!-- Kullanıcı Adı ve Gerçek Wi-Fi Sinyali & ms Ping Göstergesi -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="112" VerticalAlignment="Center" />
                                                <Border Visibility="{x:Bind VolumeBadgeVisibility, Mode=OneWay}" Background="#33F59E0B" CornerRadius="5" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind VolumeBadgeText, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#FDE68A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Visibility="{x:Bind GameStreamBadgeVisibility, Mode=OneWay}" Background="#268B5CF6" BorderBrush="#668B5CF6" BorderThickness="1" CornerRadius="5" Padding="3,1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind GameStreamStatusText, Mode=OneWay}">
                                                    <TextBlock Text="🎮" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 3 Kademeli Gerçek Wi-Fi Sinyal Çubukları + ms Değeri veya Sen Rozeti -->
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind PingToolTip, Mode=OneWay}">
                                                <!-- Sen Rozeti (Yalnızca kullanıcı kendisi için ve odada başkaları varken görünür) -->
                                                <Border Visibility="{x:Bind SelfBadgeVisibility, Mode=OneWay}"
                                                        Background="#208B5CF6" BorderBrush="#408B5CF6" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="Sen" FontSize="10" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                                </Border>

                                                <!-- Wi-Fi Sinyal Çubukları (Kendi satırında gizlenir) -->
                                                <StackPanel Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                            Visibility="{x:Bind WifiBarsVisibility, Mode=OneWay}">
                                                    <Border Width="2.5" Height="4" CornerRadius="1" Background="{x:Bind WifiBar1Brush, Mode=OneWay}" VerticalAlignment="Bottom" />
                                                    <Border Width="2.5" Height="7" CornerRadius="1" Background="{x:Bind WifiBar2Brush, Mode=OneWay}" VerticalAlignment="Bottom" />
                                                    <Border Width="2.5" Height="10" CornerRadius="1" Background="{x:Bind WifiBar3Brush, Mode=OneWay}" VerticalAlignment="Bottom" />
                                                </StackPanel>

                                                <!-- Durum Metni / ms Değeri -->
                                                <TextBlock Text="{x:Bind PingText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind PingTextBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Sağ Aksiyon ve Durum Simgeleri: Şeffaf Yuvarlatılmış Kutu İçerisinde -->
                                        <Border Grid.Column="3" Background="#0FFFFFFF" CornerRadius="10" Padding="7,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Mikrofon Durum İkonu (Kapatılınca kırmızıya döner ve üstü çizilir) -->
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Mikrofon">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{x:Bind MicStatusBrush, Mode=OneWay}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="{x:Bind MicStatusPath, Mode=OneWay}" />
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Kulaklık Durum İkonu (Sağırlaştırılınca kırmızıya döner ve üstü çizilir) -->
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Kulaklık">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{x:Bind DeafenStatusBrush, Mode=OneWay}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="{x:Bind DeafenStatusPath, Mode=OneWay}" />
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Üç Nokta Seçenekler (Kullanıcı Seçenekleri / Ayarları Popover Açar) -->
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Width="20" Height="20" CornerRadius="6" Background="Transparent" Padding="0"
                                                        ToolTipService.ToolTip="Kullanıcı Seçenekleri" Click="BtnParticipantOptions_Click" Tapped="StopPropagation_Tapped" Tag="{x:Bind}">
                                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Ellipse Canvas.Left="3" Canvas.Top="10.5" Width="3" Height="3" Fill="#94A3B8" />
                                                            <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3" Fill="#94A3B8" />
                                                            <Ellipse Canvas.Left="18" Canvas.Top="10.5" Width="3" Height="3" Fill="#94A3B8" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Alt Davet Et Butonu (Referans Görsel: sesli-oda-sol-panel.png ile Birebir) -->
                    <Border Grid.Row="2" Padding="0,10,0,0">
                        <Button x:Name="BtnLeftPanelInvite" Style="{StaticResource RunaCleanButtonStyle}"
                                HorizontalAlignment="Stretch" Height="42" CornerRadius="21"
                                Background="#148B5CF6" BorderBrush="#338B5CF6" BorderThickness="1"
                                ToolTipService.ToolTip="Oda Davet Kodunu Kopyala" Click="BtnStageCopyRoomCode_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#A855F7"
                                              Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Davet Et" FontSize="13" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ORTA ALAN: SES SAHNESİ, KULLANICI KARTLARI (sesli-oda-winui.png), CANLI YAYIN VİDEOSU VE YÜZEN KONTROLLER -->
            <Grid x:Name="VoiceCenterPanel" Grid.Column="1" PointerMoved="VoiceCenterPanel_PointerMoved">

                <!-- SAHNE İÇERİĞİ -->
                <Grid>

                    <!-- A. NORMAL SESLİ ODA SAHNESİ (KULLANICI KUTULARI - sesli-oda-winui.png İLE BİREBİR) -->
                    <Grid x:Name="DefaultVoiceStage" Visibility="Visible" Margin="0,0,0,80">
                        <!-- Arka Planda Geriye Dönük Uyumluluk İçin Gizli Referans Elemanları -->
                        <Grid Visibility="Collapsed">
                            <Ellipse x:Name="RippleRing3" /><Ellipse x:Name="RippleRing2" /><Ellipse x:Name="RippleRing1" />
                            <TextBlock x:Name="TxtStageRoomTitle" /><TextBlock x:Name="TxtStageRoomSubtitle" />
                            <TextBlock x:Name="TxtStageCapacityPill" /><TextBlock x:Name="TxtStageRoomCodePill" />
                            <TextBlock x:Name="TxtCurrentActivityPill" />
                            <Border x:Name="RemoteStreamPreviewCard" />
                        </Grid>

                        <!-- Kullanıcı Kutuları Grid / Repeater (Merkeze Hizalı, Ekrandaki Kullanıcı Sayısına Göre Yerleşim) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="940">
                            <ItemsRepeater x:Name="StageHorizontalRepeater" HorizontalAlignment="Center" Margin="24">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="248" MinItemHeight="224" MinColumnSpacing="22" MinRowSpacing="22" ItemsJustification="Center" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoomParticipant">
                                        <!-- Katılımcı kartı: cam yüzey, konuşunca yeşile dönen avatar halkası -->
                                        <Border Width="248" Height="224" CornerRadius="28"
                                                Background="{StaticResource TileGlassBrush}" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                                Loaded="InteractiveCard_Loaded"
                                                Tapped="ParticipantCard_Tapped" RightTapped="ParticipantCard_RightTapped" Tag="{x:Bind}">
                                            <Grid>
                                                <!-- Avatar + dış hale -->
                                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0" Spacing="12">
                                                    <Grid Width="116" Height="116" HorizontalAlignment="Center">
                                                        <Ellipse Width="116" Height="116" Stroke="{x:Bind SpeakingRingBrush, Mode=OneWay}" StrokeThickness="1.5" Opacity="0.55" />
                                                        <Border Width="102" Height="102" CornerRadius="51"
                                                                BorderBrush="{x:Bind SpeakingRingBrush, Mode=OneWay}" BorderThickness="3"
                                                                Background="#160F2B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarBitmap, Mode=OneWay}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="208" />
                                                </StackPanel>

                                                <!-- Yayını izle -->
                                                <Border Visibility="{x:Bind WatchStreamButtonVisibility, Mode=OneWay}"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <Button Style="{StaticResource RunaCleanButtonStyle}"
                                                            Height="28" Padding="14,0" CornerRadius="14"
                                                            Background="{StaticResource PrimaryPurpleBtnBrush}" BorderBrush="#66C084FC" BorderThickness="1"
                                                            Click="BtnWatchRemoteStreamFromCard_Click" Tapped="StopPropagation_Tapped" Tag="{x:Bind}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="24" Height="24">
                                                                    <Polygon Points="5,3 19,12 5,21" Fill="White" />
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="Yayını İzle" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Border>

                                                <!-- Oyun Akışı rozeti (sol üst) -->
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                                        Visibility="{x:Bind GameStreamBadgeVisibility, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind GameStreamStatusText, Mode=OneWay}">
                                                    <TextBlock Text="🎮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Mikrofon kapalı rozeti (sağ üst) -->
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#EF4444"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                                        Visibility="{x:Bind EffectiveMutedVisibility, Mode=OneWay}">
                                                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Stroke="White" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Data="M1,1 L23,23 M9,9 V12 A3,3 0 0,0 14.12,14.12 M15,9.34 V4 A3,3 0 0,0 9.06,3.4 M17,16.95 A7,7 0 0,1 5,12 V10" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!-- B. CANLI EKRAN PAYLAŞIMI SAHNESİ -->
                    <Grid x:Name="ScreenShareStage" Visibility="Collapsed" Margin="14,14,14,80">

                        <!-- 1. KENDİSİ YAYIN YAPAN KULLANICI İÇİN TASARRUF KARTI (Sıfır Yerel Çözme CPU / GPU Tasarrufu) -->
                        <Border x:Name="BroadcasterActiveCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="520" CornerRadius="22" Background="#E60D091F" BorderBrush="#7C3AED" BorderThickness="1.6" Padding="28,24">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#268B5CF6" BorderBrush="#7C3AED" BorderThickness="2" HorizontalAlignment="Center">
                                    <Viewbox Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#C084FC" StrokeThickness="2" StrokeLineJoin="Round"
                                                  Data="M4,3 H20 A2,2 0 0,1 22,5 V15 A2,2 0 0,1 20,17 H4 A2,2 0 0,1 2,15 V5 A2,2 0 0,1 4,3 Z M8,21 H16 M12,17 V21" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Border Background="#DC2626" CornerRadius="6" Height="22" Padding="10,0" HorizontalAlignment="Center">
                                        <TextBlock Text="● CANLI YAYINDASINIZ" FontSize="11" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtBroadcasterActiveTitle" Text="Ekranınız Odadaki Katılımcılara Aktarılıyor" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock Text="Uygulama ekranındayken CPU ve kaynak tasarrufu sağlamak için yerel önizleme durduruldu." FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
                                </StackPanel>

                                <Border Background="#12FFFFFF" CornerRadius="12" Padding="14,10" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="YAYIN KALİTESİ" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBroadcasterSpec" Text="1080p • 60 FPS" FontSize="13" FontWeight="Bold" Foreground="#DDD6FE" />
                                                <Border x:Name="BadgeBroadcasterAdaptive" Visibility="Collapsed" Background="#288B5CF6" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtBroadcasterAdaptiveIndicator" Text="OTOMATİK =" FontSize="10" FontWeight="Bold" Foreground="#C4B5FD" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="GÖNDERİLEN BİTRATE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="TxtBroadcasterBitrate" Text="4.5 Mbps" FontSize="13" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Ekran Üstü Çizim İzni ve Yönetimi (Yayıncı) -->
                                <Border Background="#12FFFFFF" CornerRadius="12" Padding="14,10" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="TglAllowAnnotations" Header="İzleyiciler ekranıma çizebilsin"
                                                          OffContent="Kapalı" OnContent="Açık"
                                                          Toggled="TglAllowAnnotations_Toggled" />
                                            <TextBlock x:Name="TxtAnnotationHint" Text="" FontSize="11" Foreground="#F59E0B"
                                                       Visibility="Collapsed" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="BtnClearAnnotations" Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}"
                                                Content="🧹 Çizimleri Temizle" Height="32" Padding="12,0" CornerRadius="8"
                                                Background="#268B5CF6" BorderBrush="#55A855F7" BorderThickness="1"
                                                Foreground="#EDE9FE" FontSize="11.5" FontWeight="SemiBold"
                                                VerticalAlignment="Center" Click="BtnClearAnnotations_Click" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource RunaCleanButtonStyle}" Content="⚙️ Yayını Düzenle" Height="36" Padding="16,0" CornerRadius="10"
                                            Background="#268B5CF6" BorderBrush="#55A855F7" BorderThickness="1" Foreground="#EDE9FE" FontSize="12.5" FontWeight="SemiBold"
                                            Click="BtnEditLiveStream_Click" />
                                    <Button Style="{StaticResource RunaCleanButtonStyle}" Content="🛑 Paylaşımı Durdur" Height="36" Padding="18,0" CornerRadius="10"
                                            Background="#DC2626" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                            Click="BtnStopScreenShare_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. YAYIN İZLEME KUTUSU (Küçük / PIP Kutusunda Başlar, Sağ Altta Kontroller, Tam Ekran Olabilir) -->
                        <Border x:Name="StreamWatchCard" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="880" MaxHeight="520" CornerRadius="18" Background="#05030A" BorderBrush="#4D8B5CF6" BorderThickness="1.5">
                            <Grid>
                                <!-- Canlı Video Yüzeyi (DirectX SwapChainPanel - Sıfır Kopya Donanım Gösterimi) -->
                                <SwapChainPanel x:Name="LiveStreamSwapChainPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                DoubleTapped="LiveStreamVideoImage_DoubleTapped"
                                                SizeChanged="LiveStreamSwapChainPanel_SizeChanged" />

                                <!-- Canlı Video Yüzeyi (Yedek WriteableBitmap / Eski Motor) -->
                                <Image x:Name="LiveStreamVideoImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       DoubleTapped="LiveStreamVideoImage_DoubleTapped"
                                       SizeChanged="LiveStreamVideoImage_SizeChanged" />

                                <!-- Çizim Tuvali (İzleyici Modu) -->
                                <Canvas x:Name="AnnotationCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        PointerPressed="AnnotationCanvas_PointerPressed"
                                        PointerMoved="AnnotationCanvas_PointerMoved"
                                        PointerReleased="AnnotationCanvas_PointerReleased"
                                        PointerCaptureLost="AnnotationCanvas_PointerCaptureLost"
                                        PointerCanceled="AnnotationCanvas_PointerCaptureLost" />

                                <!-- Çizim Araç Çubuğu (Toolbar - Yüzen) -->
                                <Border x:Name="AnnotationToolbar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                                        Background="#E6100924" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="16" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- 8 Renk Dairesi -->
                                        <StackPanel x:Name="AnnColorPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="0" Width="22" Height="22" CornerRadius="11" Background="#F43F5E" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Gül Kırmızısı" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="1" Width="22" Height="22" CornerRadius="11" Background="#F59E0B" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Kehribar Sarısı" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="2" Width="22" Height="22" CornerRadius="11" Background="#22C55E" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Zümrüt Yeşili" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="3" Width="22" Height="22" CornerRadius="11" Background="#06B6D4" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Camgöbeği" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="4" Width="22" Height="22" CornerRadius="11" Background="#3B82F6" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Canlı Mavi" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="5" Width="22" Height="22" CornerRadius="11" Background="#A855F7" BorderBrush="White" BorderThickness="0" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Mor" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="6" Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" BorderBrush="#888888" BorderThickness="1" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Beyaz" />
                                            <Button Style="{StaticResource RunaCleanButtonStyle}" Tag="7" Width="22" Height="22" CornerRadius="11" Background="#111827" BorderBrush="#555555" BorderThickness="1" Padding="0" Click="AnnColorButton_Click" ToolTipService.ToolTip="Koyu Gri" />
                                        </StackPanel>

                                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="2,0" />

                                        <!-- 3 Kalınlık Düğmesi -->
                                        <StackPanel x:Name="AnnWidthPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button x:Name="BtnAnnWidthThin" Style="{StaticResource RunaCleanButtonStyle}" Tag="0" Content="İnce" Height="26" Padding="8,0" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" FontSize="11" Foreground="#DDD6FE" Click="AnnWidthButton_Click" />
                                            <Button x:Name="BtnAnnWidthMedium" Style="{StaticResource RunaCleanButtonStyle}" Tag="1" Content="Orta" Height="26" Padding="8,0" CornerRadius="6" Background="#7C3AED" BorderBrush="#A855F7" BorderThickness="1" FontSize="11" FontWeight="SemiBold" Foreground="White" Click="AnnWidthButton_Click" />
                                            <Button x:Name="BtnAnnWidthThick" Style="{StaticResource RunaCleanButtonStyle}" Tag="2" Content="Kalın" Height="26" Padding="8,0" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" FontSize="11" Foreground="#DDD6FE" Click="AnnWidthButton_Click" />
                                        </StackPanel>

                                        <Border Width="1" Height="18" Background="#33FFFFFF" Margin="2,0" />

                                        <!-- Benimkileri Temizle Düğmesi -->
                                        <Button x:Name="BtnClearMyAnnotations" Style="{StaticResource RunaCleanButtonStyle}" Content="🧹 Benimkileri Temizle" Height="26" Padding="10,0" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" FontSize="11" Foreground="#EDE9FE" Click="BtnClearMyAnnotations_Click" />

                                        <!-- Bitti (Esc) Düğmesi -->
                                        <Button x:Name="BtnExitAnnotationMode" Style="{StaticResource RunaCleanButtonStyle}" Content="✓ Bitti (Esc)" Height="26" Padding="12,0" CornerRadius="6" Background="#7C3AED" BorderBrush="#A855F7" BorderThickness="1" FontSize="11" FontWeight="Bold" Foreground="White" Click="BtnExitAnnotationMode_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Üst Orta Yüzen Yayın Ayarları Pop-up Bildirimi (Değişiklik olduğunda gösterilir) -->
                                <Border x:Name="StreamSettingsToast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                                        Background="#E6100924" BorderBrush="#7C3AED" BorderThickness="1.2" CornerRadius="12" Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtStreamSettingsToastMsg" Text="Yayın Ayarları Güncellendi: 1080p @ 60 FPS" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Sağ Üst Yayın Başlığı ve Canlı Rozeti -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                                    <Border Background="#DC2626" CornerRadius="6" Height="22" Padding="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="● CANLI" FontSize="10" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TxtScreenShareTitle" Text="Ekran Paylaşımı" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    <Border Background="#228B5CF6" CornerRadius="6" Height="22" Padding="8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtStreamSpecBadge" Text="1080p • 60 FPS" FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <!-- SAĞ ALT YAYIN KONTROLLERİ (Üç Nokta: Keskinlik + Telemetri, ve Tam Ekran Butonu) -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                                        CornerRadius="12" Background="#B3090614" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Çizim Modu Butonu (Kalem) -->
                                        <Button x:Name="BtnAnnotateToggle" Style="{StaticResource RunaCleanButtonStyle}"
                                                Width="32" Height="30" CornerRadius="8" Background="Transparent"
                                                Visibility="Collapsed"
                                                ToolTipService.ToolTip="Yayın Üzerine Çiz (Kalem)"
                                                Click="BtnAnnotateToggle_Click">
                                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 A1,1 0 0,0 20.71,5.63 L18.37,3.29 A1,1 0 0,0 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>

                                        <!-- Üç Nokta Seçenek Butonu (Keskinlik ve Telemetri Menüsü) -->
                                        <Button x:Name="BtnStreamOptions" Style="{StaticResource RunaCleanButtonStyle}"
                                                Width="32" Height="30" CornerRadius="8" Background="Transparent"
                                                ToolTipService.ToolTip="Yayın Seçenekleri (Keskinlik &amp; Telemetri)">
                                            <FlyoutBase.AttachedFlyout>
                                                <Flyout x:Name="StreamSharpnessFlyout" Placement="TopEdgeAlignedRight">
                                                    <Border Width="290" Padding="14" CornerRadius="14" Background="#E60E0B1D" BorderBrush="#338B5CF6" BorderThickness="1">
                                                        <StackPanel Spacing="12">
                                                            <!-- Başlık ve Değer -->
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="✨" FontSize="13" />
                                                                    <TextBlock Text="Görüntü Keskinliği" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="TxtSharpnessPopupValue" Text="%0" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>

                                                            <!-- 0-100 Slider (Adım 5) -->
                                                            <Slider x:Name="SliderSharpnessPopup" Minimum="0" Maximum="100" StepFrequency="5"
                                                                    ValueChanged="SliderSharpnessPopup_ValueChanged" HorizontalAlignment="Stretch" Margin="0,-2,0,-2" />

                                                            <!-- Hazır Ayar Çipleri -->
                                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                                <Button x:Name="ChipSharpness0" Grid.Column="0" Tag="0" Style="{StaticResource RunaCleanButtonStyle}"
                                                                        Height="28" CornerRadius="6" Background="#14FFFFFF" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"
                                                                        Content="Kapalı %0" Click="SharpnessChip_Click" HorizontalAlignment="Stretch" />
                                                                <Button x:Name="ChipSharpness30" Grid.Column="1" Tag="30" Style="{StaticResource RunaCleanButtonStyle}"
                                                                        Height="28" CornerRadius="6" Background="#14FFFFFF" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"
                                                                        Content="Düşük %30" Click="SharpnessChip_Click" HorizontalAlignment="Stretch" />
                                                                <Button x:Name="ChipSharpness60" Grid.Column="2" Tag="60" Style="{StaticResource RunaCleanButtonStyle}"
                                                                        Height="28" CornerRadius="6" Background="#14FFFFFF" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"
                                                                        Content="Orta %60" Click="SharpnessChip_Click" HorizontalAlignment="Stretch" />
                                                                <Button x:Name="ChipSharpness100" Grid.Column="3" Tag="100" Style="{StaticResource RunaCleanButtonStyle}"
                                                                        Height="28" CornerRadius="6" Background="#14FFFFFF" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"
                                                                        Content="Kristal %100" Click="SharpnessChip_Click" HorizontalAlignment="Stretch" />
                                                            </Grid>

                                                            <!-- Açıklama -->
                                                            <TextBlock Text="Yazı ve arayüz kenarlarını netleştirir; yüksek değerler sıkıştırma kusurlarını belirginleştirebilir."
                                                                       FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </FlyoutBase.AttachedFlyout>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="Top">
                                                    <MenuFlyoutItem x:Name="MenuStreamSharpnessItem" Text="✨  Görüntü Keskinliği… (%0)" Click="MenuStreamSharpness_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <ToggleMenuFlyoutItem x:Name="MenuToggleTelemetryPanel" Text="📊  Telemetri Paneli" Click="MenuToggleTelemetryPanel_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="3" Canvas.Top="10.5" Width="3" Height="3" Fill="White" />
                                                    <Ellipse Canvas.Left="10.5" Canvas.Top="10.5" Width="3" Height="3" Fill="White" />
                                                    <Ellipse Canvas.Left="18" Canvas.Top="10.5" Width="3" Height="3" Fill="White" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>

                                        <!-- Tam Ekran Butonu -->
                                        <Button x:Name="BtnStreamFullscreen" Style="{StaticResource RunaCleanButtonStyle}"
                                                ToolTipService.ToolTip="Tam Ekran İzle (Çift Tık veya Esc)"
                                                Background="#228B5CF6" BorderBrush="#55A855F7" BorderThickness="1"
                                                CornerRadius="8" Width="32" Height="30" Click="BtnStreamFullscreen_Click">
                                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M8,3 H5 A2,2 0 0,0 3,5 V8 M21,8 V5 A2,2 0 0,0 19,3 H16 M16,21 H19 A2,2 0 0,0 21,19 V16 M3,16 V19 A2,2 0 0,0 5,21 H8" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ALT YÜZEN CAM KAPSÜL KONTROL ÇUBUĞU (sesli-oda-winui.png İLE BİREBİR) -->
                <Grid x:Name="BottomVoiceControlBar" VerticalAlignment="Bottom" Padding="0,4,0,16">
                    <Border HorizontalAlignment="Center" CornerRadius="36" Padding="12,10"
                            Background="#E610091F" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                            <!-- 1. Mikrofon Aç / Kapat -->
                            <Border CornerRadius="26" Padding="0" Background="Transparent">
                                <Button x:Name="BtnMuteToggle" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        ToolTipService.ToolTip="Mikrofonu Sustur / Aç (Ctrl+Shift+M)" Click="BtnMuteToggle_Click">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox x:Name="IconMicOpen" Width="18" Height="18" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M12,1 A3,3 0 0,0 9,4 V12 A3,3 0 0,0 15,12 V4 A3,3 0 0,0 12,1 Z M19,10 V12 A7,7 0 0,1 5,12 V10 M12,19 V23 M8,23 H16" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="IconMicMuted" Width="18" Height="18" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M1,1 L23,23 M9,9 V12 A3,3 0 0,0 14.12,14.12 M15,9.34 V4 A3,3 0 0,0 9.06,3.4 M17,16.95 A7,7 0 0,1 5,12 V10 M19,10 V12 M12,19 V23 M8,23 H16" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- 2. Kulaklık (Sağırlaştır) Aç / Kapat -->
                            <Border CornerRadius="26" Padding="0" Background="Transparent">
                                <Button x:Name="BtnDeafenToggle" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        ToolTipService.ToolTip="Kulaklığı Sağırlaştır / Aç (Ctrl+Shift+D)" Click="BtnDeafenToggle_Click">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox x:Name="IconHeadphoneOpen" Width="18" Height="18" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M3,18 V12 A9,9 0 0,1 21,12 V18 M21,19 A2,2 0 0,1 19,21 H18 A2,2 0 0,1 16,19 V16 A2,2 0 0,1 18,14 H21 Z M3,19 A2,2 0 0,0 5,21 H6 A2,2 0 0,0 8,19 V16 A2,2 0 0,0 6,14 H3 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="IconHeadphoneDeafened" Width="18" Height="18" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M1,1 L23,23 M3,18 V12 A9,9 0 0,1 6.4,5 M10.5,3.2 A9,9 0 0,1 21,12 V16 M21,19 A2,2 0 0,1 19,21 H18 A2,2 0 0,1 16,19 V16 M3,19 A2,2 0 0,0 5,21 H6 A2,2 0 0,0 8,19 V16 A2,2 0 0,0 6,14 H3 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- 3. Ekran Paylaşımı Başlat / Durdur (EKRAN/MONİTÖR İKONU KULLANILDI, SOHBET BALONU DEĞİL!) -->
                            <Border CornerRadius="26" Padding="0" Background="Transparent">
                                <Button x:Name="BtnScreenShareToggle" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        ToolTipService.ToolTip="Ekran veya Uygulama Penceresi Paylaş" Click="BtnScreenShareToggle_Click">
                                    <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M4,3 H20 A2,2 0 0,1 22,5 V15 A2,2 0 0,1 20,17 H4 A2,2 0 0,1 2,15 V5 A2,2 0 0,1 4,3 Z M8,21 H16 M12,17 V21" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Border>

                            <!-- 4. Ses Paneli (Soundpad) (YENİ VEKTÖREL SES DALGASI İKONU) -->
                            <Border CornerRadius="24" Padding="2" Background="#338B5CF6">
                                <Button x:Name="BtnSoundpadToggle" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#268B5CF6" BorderBrush="#55A855F7" BorderThickness="1"
                                        ToolTipService.ToolTip="Ses Paneli (Soundpad)" Click="BtnSoundpadToggle_Click">
                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#E9D5FF"
                                                  Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Border>

                            <!-- 5. Diğer / Ses Ayarları (...) -->
                            <Border CornerRadius="26" Padding="0" Background="Transparent">
                                <Button x:Name="BtnStageMore" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                        ToolTipService.ToolTip="Ses Ayarları ve Oda Seçenekleri">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Top">
                                            <MenuFlyoutItem Text="⚙️  Ses Ayarları" Click="BtnOpenSettings_Click" />
                                            <MenuFlyoutItem x:Name="BtnMenuGameStream" Text="🎮  Oyun Akışı" Click="BtnOpenGameStream_Click" />
                                            <MenuFlyoutItem x:Name="BtnMenuSpatialAudio" Text="🎧  3B Uzamsal Ses" Click="BtnOpenSpatialAudio_Click" />
                                            <MenuFlyoutItem Text="🎙️  30 Saniye Mikrofon Testi" Click="BtnQuickMicTest_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="📋  Oda Davet Kodunu Kopyala" Click="BtnStageCopyRoomCode_Click" />
                                            <MenuFlyoutItem Text="⭐  Kalıcı Odalara Sabitle / Kaldır" Click="BtnStagePinRoom_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="3.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="White" />
                                            <Ellipse Canvas.Left="10.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="White" />
                                            <Ellipse Canvas.Left="17.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="White" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Border>

                            <Border Width="1" Height="22" Background="#26FFFFFF" Margin="2,0" VerticalAlignment="Center" />

                            <!-- 6. Odadan Ayrıl (BEYAZ ÇİZGİSİ KESİNLİKLE KALDIRILDI) -->
                            <Border CornerRadius="24" Padding="2" Background="#40FF5C6E">
                                <Button x:Name="BtnLeaveVoice" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="#FF5C6E" BorderThickness="0" BorderBrush="Transparent"
                                        ToolTipService.ToolTip="Odadan Ayrıl" Click="BtnLeaveVoice_Click">
                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9" />
                                            <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M16,17 L21,12 L16,7 M21,12 H9" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Border>

                            <!-- 7. Yayından Çık Butonu (Aramadan Çık Butonunun Sağında, Yalnızca Yayın İzlenirken Görünür).
                                 Dış çerçeve kaldırıldı: düğme gizliyken bile görünen 2 px'lik kırmızı dikey şerit bırakıyordu. -->
                                <Button x:Name="BtnExitStreamInBottomBar" Style="{StaticResource RunaCleanButtonStyle}" Visibility="Collapsed"
                                        Height="40" Padding="14,0" CornerRadius="20"
                                        Background="#33FF5C6E" BorderBrush="#80FF5C6E" BorderThickness="1"
                                        ToolTipService.ToolTip="Canlı Ekran İzlemeyi Kapat" Click="BtnExitStreamInBottomBar_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#FFA3AF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Yayından Çık" FontSize="12" FontWeight="Bold" Foreground="#FFA3AF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- SAĞ PANEL: SOHBET (sesli-oda-sag-panel.png ve sesli-oda-sag-panel-bos.png İLE BİREBİR) -->
            <Border x:Name="VoiceRightChatPanel" Grid.Column="2" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="24" Margin="5,10,10,10" Padding="14,16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 1. PANEL BAŞLIK ALANI (Yalnızca Sohbet İkonu ve "Sohbet" Başlığı; X, Küçültme, Mikrofon Kesinlikle Yok) -->
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#268B5CF6" VerticalAlignment="Center">
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#A855F7"
                                                  Data="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Sohbet" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Başlık Altı İnce Ayırıcı Çizgi -->
                            <Border Height="1" Background="#1CFFFFFF" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 2. MESAJ LİSTESİ VE BOŞ SOHBET GÖRÜNÜMÜ -->
                    <Grid Grid.Row="1">
                        <!-- Boş Sohbet Tasarımı (sesli-oda-sag-panel-bos.png İle Birebir) -->
                        <Border x:Name="RoomChatEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <!-- Zarif Sohbet / Balon İkonu -->
                                <Border Width="68" Height="68" CornerRadius="34" Background="#168B5CF6" BorderBrush="#338B5CF6" BorderThickness="1.5" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#A855F7" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  Data="M21,15 A2,2 0 0,1 19,17 H7 L3,21 V5 A2,2 0 0,1 5,3 H19 A2,2 0 0,1 21,5 Z" />
                                            <Ellipse Canvas.Left="7" Canvas.Top="9" Width="2" Height="2" Fill="#C084FC" />
                                            <Ellipse Canvas.Left="11" Canvas.Top="9" Width="2" Height="2" Fill="#C084FC" />
                                            <Ellipse Canvas.Left="15" Canvas.Top="9" Width="2" Height="2" Fill="#C084FC" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Henüz mesaj yok" FontSize="14.5" FontWeight="Bold" Foreground="#EDE9FE" HorizontalAlignment="Center" />
                                <TextBlock Text="Sohbeti başlatmak için mesaj gönderebilirsin." FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                            </StackPanel>
                        </Border>

                        <!-- WhatsApp Benzeri İki Yönlü Mesaj Akışı -->
                        <ListView x:Name="ChatMessagesList" SelectionMode="None" ItemContainerStyle="{StaticResource CleanListViewItemStyle}"
                                  Padding="0,0,4,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessage">
                                    <Grid Margin="0,6,0,12" HorizontalAlignment="Stretch">
                                        <!-- Mesaj Satırı (WhatsApp Düzeni: Diğerleri Solda, Kendi Mesajlarım Sağda) -->
                                        <Grid HorizontalAlignment="{x:Bind BubbleHorizontalAlignment, Mode=OneWay}" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <!-- Kolon 0: Diğer Kullanıcının Sol Avatarı -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Kolon 1: Mesaj Balonu ve İçeriği -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Kolon 2: Kendi Sağ Avatarım -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol Avatar (Diğer Kullanıcılar İçin, Yeşil Durum Noktası Kesinlikle Yok) -->
                                            <Ellipse Grid.Column="0" Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                     Visibility="{x:Bind OtherUserVisibility, Mode=OneWay}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind SenderAvatarBitmap}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- Orta: Mesaj Balonu -->
                                            <StackPanel Grid.Column="1" MaxWidth="270" Spacing="2">
                                                <!-- Diğer Kullanıcı Adı ve Mesaj Saati -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2,4,4"
                                                            Visibility="{x:Bind OtherUserVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind SenderName}" FontWeight="Bold" FontSize="11.5" Foreground="#C084FC" />
                                                    <TextBlock Text="{x:Bind TimeString}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Kendi Mesajımın Saati (Sağa Hizalı) -->
                                                <TextBlock Text="{x:Bind TimeString}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,4,2"
                                                           Visibility="{x:Bind OwnMessageVisibility, Mode=OneWay}" />

                                                <!-- Ana Balon Gövdesi -->
                                                <Border Background="{x:Bind BubbleBackground, Mode=OneWay}"
                                                        BorderBrush="{x:Bind BubbleBorder, Mode=OneWay}" BorderThickness="1"
                                                        CornerRadius="{x:Bind BubbleCornerRadius, Mode=OneWay}"
                                                        Padding="12,9">
                                                    <StackPanel Spacing="6">
                                                        <!-- 1. WhatsApp Tarzı Önizleme Kartı (Yalnızca LinkPreview varsa) -->
                                                        <Button Visibility="{x:Bind HasLinkPreview, Mode=OneWay}"
                                                                Style="{StaticResource RunaCleanButtonStyle}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Padding="0" Margin="0,0,0,2" Tag="{x:Bind}" Click="BtnChatLinkPreviewCard_Click">
                                                            <Border CornerRadius="8" Background="#26000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                                <StackPanel Spacing="6" Padding="0,0,0,8">
                                                                    <!-- Kapak Resmi (16:9, Köşe 8) -->
                                                                    <Grid Visibility="{x:Bind LinkPreview.HasThumbnail, Mode=OneWay}"
                                                                          Height="120" HorizontalAlignment="Stretch" CornerRadius="8,8,0,0">
                                                                        <Image Source="{x:Bind LinkPreview.ThumbnailBitmap, Mode=OneWay}"
                                                                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <!-- YouTube ise Yarı Saydam Oynat Butonu Katmanı -->
                                                                        <Border Visibility="{x:Bind LinkPreview.IsYouTube, Mode=OneWay}"
                                                                                Width="40" Height="40" CornerRadius="20" Background="#B3000000"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Canvas Width="24" Height="24">
                                                                                    <Path Fill="White" Data="M8 5v14l11-7z" />
                                                                                </Canvas>
                                                                            </Viewbox>
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Önizleme Metinleri -->
                                                                    <StackPanel Spacing="3" Padding="8,4,8,0">
                                                                        <!-- Site Adı -->
                                                                        <TextBlock Text="{x:Bind LinkPreview.SiteName, Mode=OneWay}"
                                                                                   FontSize="10.5" Foreground="#94A3B8" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                                   Visibility="{x:Bind LinkPreview.HasSiteName, Mode=OneWay}" />
                                                                        <!-- Başlık -->
                                                                        <TextBlock Text="{x:Bind LinkPreview.Title, Mode=OneWay}"
                                                                                   FontSize="12" Foreground="#F8FAFC" FontWeight="Bold"
                                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                        <!-- Açıklama -->
                                                                        <TextBlock Text="{x:Bind LinkPreview.Description, Mode=OneWay}"
                                                                                   FontSize="11" Foreground="#94A3B8"
                                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{x:Bind LinkPreview.HasDescription, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Button>

                                                        <!-- A. Düz Metin Mesajı (Tıklanabilir Bağlantılar Destekli) -->
                                                        <RichTextBlock services:ChatRichTextHelper.FormattedText="{x:Bind Text, Mode=OneWay}"
                                                                       FontSize="12.5" Foreground="#F8FAFC" TextWrapping="Wrap"
                                                                       IsTextSelectionEnabled="True" Visibility="{x:Bind HasText, Mode=OneWay}" />

                                                        <!-- B. Dosya Paylaşım Kartı (sesli-oda-sag-panel.png İle Birebir) -->
                                                        <Border Visibility="{x:Bind HasFile, Mode=OneWay}" CornerRadius="10" Background="#26000000" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,8">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Dosya Simgesi (Mavi Döküman Rozeti) -->
                                                                <Border Grid.Column="0" Width="36" Height="40" CornerRadius="6" Background="#2563EB" VerticalAlignment="Center">
                                                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Fill="White" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Border>

                                                                <!-- Dosya Adı ve Boyutu -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{x:Bind FileAttachment.FileName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind FileAttachment.FileSizeString, Mode=OneWay}" FontSize="10.5" Foreground="#94A3B8" />
                                                                </StackPanel>

                                                                <!-- İndir / Aç Butonu -->
                                                                <Button Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}"
                                                                        Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF"
                                                                        ToolTipService.ToolTip="Dosyayı Aç / İndir" Click="BtnDownloadOrOpenFile_Click" Tag="{x:Bind}">
                                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                  Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <!-- C. Anket Kartı (sesli-oda-sag-panel.png İle Birebir) -->
                                                        <Border Visibility="{x:Bind HasPoll, Mode=OneWay}" CornerRadius="12" Background="#26000000" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,10">
                                                            <StackPanel Spacing="8">
                                                                <!-- Anket Başlığı -->
                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Fill="#A855F7" Data="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{x:Bind PollData.Question, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                                </StackPanel>

                                                                <!-- Seçenek 1 -->
                                                                <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Background="Transparent" Padding="0,2" Click="BtnVotePollOption1_Click" Tag="{x:Bind}">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Grid.Column="0" Width="14" Height="14" Stroke="#A855F7" StrokeThickness="2" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                            <TextBlock Text="{x:Bind PollData.Option1.Text, Mode=OneWay}" FontSize="11.5" Foreground="#E2E8F0" />
                                                                            <ProgressBar Value="{x:Bind PollData.Option1.Percent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#7C3AED" Background="#26FFFFFF" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind PollData.Option1.PercentString, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>

                                                                <!-- Seçenek 2 -->
                                                                <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Background="Transparent" Padding="0,2" Click="BtnVotePollOption2_Click" Tag="{x:Bind}">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Grid.Column="0" Width="14" Height="14" Stroke="#A855F7" StrokeThickness="2" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                            <TextBlock Text="{x:Bind PollData.Option2.Text, Mode=OneWay}" FontSize="11.5" Foreground="#E2E8F0" />
                                                                            <ProgressBar Value="{x:Bind PollData.Option2.Percent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#7C3AED" Background="#26FFFFFF" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind PollData.Option2.PercentString, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>

                                                                <!-- Anket Süresi -->
                                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                                                    <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Stroke="#94A3B8" StrokeThickness="2" Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{x:Bind PollData.DurationLabel, Mode=OneWay}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Sağ Avatar (Kendi Mesajlarım İçin, Yeşil Durum Noktası Kesinlikle Yok) -->
                                            <Ellipse Grid.Column="2" Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                     Visibility="{x:Bind OwnMessageVisibility, Mode=OneWay}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind SenderAvatarBitmap}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 3. MESAJ YAZMA ALANI (Bütünleşik Kapsayıcı: Sol: +, Orta: Metin Girişi, Sağ: Emoji + Gönder) -->
                    <Border Grid.Row="2" Margin="0,10,0,0">
                        <!-- Metin Kutusu Kapsayıcısı: Hafif Yuvarlatılmış (CornerRadius="12"), Dışında Parlama/Gölge -->
                        <Border Background="#16102A" BorderBrush="#4A3B72" BorderThickness="1.2" CornerRadius="12" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Sol: Duvarı ve Arka Planı Olmayan + Butonu -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Orta: Metin Girişi (Artı Butonunun Yanından Mesafe ile Başlar) -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Sağ: Emoji Butonu -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Sağ: Gönder Butonu -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- + Butonu: Duvarları ve arka planı yok -->
                                <Button x:Name="BtnChatPlusMenu" Grid.Column="0" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="32" Height="32" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Dosya Paylaş veya Anket Oluştur">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Top">
                                            <MenuFlyoutItem Text="📁  Dosya Yükle (Ctrl+F)" Click="BtnAttachFile_Click" />
                                            <MenuFlyoutItem Text="📊  Anket Oluştur" Click="BtnOpenCreatePoll_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#DDD6FE" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,5 V19 M5,12 H19" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <!-- Metin Giriş Kutusu (Artı Butonunun Yanından İtibaren Mesafe İle Başlar) -->
                                <TextBox x:Name="TxtChatInput" Grid.Column="1" PlaceholderText="Mesajınızı yazın..."
                                         Margin="6,0,6,0" Background="Transparent" BorderThickness="0"
                                         FontSize="12.5" Foreground="#F8FAFC" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         KeyDown="TxtChatInput_KeyDown">
                                    <TextBox.Resources>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- Emoji Butonu (Metin Kutusunun İçerisinde Sağda) -->
                                <Button x:Name="BtnChatEmoji" Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="30" Height="30" CornerRadius="8" Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                                        ToolTipService.ToolTip="Emoji Ekle">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <VariableSizedWrapGrid MaximumRowsOrColumns="5" ItemWidth="36" ItemHeight="36" Orientation="Horizontal">
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="👋" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="👋" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="✨" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="✨" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="🔥" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="🔥" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="👍" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="👍" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="🎉" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="🎉" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="😊" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="😊" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="❤️" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="❤️" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="😂" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="😂" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="🚀" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="🚀" />
                                                <Button Style="{StaticResource RunaCleanButtonStyle}" Content="🎮" FontSize="18" Width="36" Height="36" Click="EmojiItem_Click" Tag="🎮" />
                                            </VariableSizedWrapGrid>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#CBD5E1" StrokeThickness="1.8" />
                                            <Ellipse Canvas.Left="7" Canvas.Top="8" Width="3" Height="3" Fill="#CBD5E1" />
                                            <Ellipse Canvas.Left="14" Canvas.Top="8" Width="3" Height="3" Fill="#CBD5E1" />
                                            <Path Stroke="#CBD5E1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,14 C9.3,16 14.7,16 16,14" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <!-- Mor Neon Gönder Butonu (Metin Kutusunun İçerisinde En Sağda) -->
                                <Button x:Name="BtnSendChat" Grid.Column="3" Style="{StaticResource RunaCleanButtonStyle}"
                                        Width="32" Height="32" CornerRadius="10"
                                        Background="{StaticResource PrimaryPurpleBtnBrush}" BorderBrush="#A855F7" BorderThickness="1"
                                        ToolTipService.ToolTip="Gönder (Enter)" Click="BtnSendChat_Click">
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 3. KİŞİYE ÖZEL %0-%200 SES YÜKSELTİCİ POP-UP MENÜSÜ               -->
        <!-- ================================================================= -->
        <Grid x:Name="VoiceUserPopoverOverlay" Background="#80000000" Visibility="Collapsed" Tapped="BackdropClosePopover_Tapped">
            <Border x:Name="VoiceUserPopoverCard" Width="384" MaxHeight="780" CornerRadius="22" BorderBrush="#4D8B5CF6" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="StopPropagation_Tapped">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1A1433" Offset="0" />
                        <GradientStop Color="#0E0B1D" Offset="0.38" />
                    </LinearGradientBrush>
                </Border.Background>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="20,18,20,20" Spacing="16">

                        <!-- ÜST: Avatar, ad, bağlantı çipi, kapat -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Padding="3" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0" />
                                        <GradientStop Color="#6366F1" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="PopoverAvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="TxtPopoverUserName" Text="Kullanıcı" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <Border x:Name="PopoverConnChip" HorizontalAlignment="Left" CornerRadius="7" Padding="8,3" Background="#1A94A3B8" BorderBrush="#3394A3B8" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="PopoverConnDot" Width="6" Height="6" Fill="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtPopoverConnChip" Text="Bağlanıyor…" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}" Width="32" Height="32" CornerRadius="10" VerticalAlignment="Top"
                                    Background="#12FFFFFF" Click="BtnCloseUserPopover_Click" ToolTipService.ToolTip="Kapat">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#CBD5E1" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <!-- GECİKME: Ağ ve Ses kartları -->
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="14" Padding="12,11" Background="#0F38BDF8" BorderBrush="#2638BDF8" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="#38BDF8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M4,17 L9,12 L13,16 L20,8 M15,8 H20 V13" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="AĞ GECİKMESİ" FontSize="9.5" FontWeight="Bold" CharacterSpacing="60" Foreground="#7DD3FC" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPopoverNetRtt" Text="—" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Gidiş-dönüş · yalnızca ağ" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtPopoverNetJitter" Text="" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="14" Padding="12,11" Background="#0FA855F7" BorderBrush="#26A855F7" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="#C084FC" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5 M19,5 A10,10 0 0 1 19,19" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="SES GECİKMESİ" FontSize="9.5" FontWeight="Bold" CharacterSpacing="60" Foreground="#D8B4FE" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPopoverAudioLatency" Text="—" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Tek yön · sıkıştırma ve çözme dahil" FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtPopoverCodecShare" Text="" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Ses gecikmesi dökümü: yığılmış çubuk + açıklama -->
                            <Border CornerRadius="14" Padding="12,11" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Ses gecikmesi nereden geliyor?" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <Border CornerRadius="4" Height="8" Background="#14FFFFFF">
                                        <Grid x:Name="PopoverLatencyBar" />
                                    </Border>
                                    <Grid x:Name="PopoverLatencyLegend" ColumnSpacing="14" RowSpacing="4" />
                                    <TextBlock x:Name="TxtPopoverLatencyNote" Text="" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <TextBlock x:Name="TxtPopoverEngineNote" Text="Motor: Standart" FontSize="10" Foreground="#818CF8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SES SEVİYESİ -->
                        <Border CornerRadius="14" Padding="14,12" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="#A78BFA" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M11,5 L6,9 H2 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Ses Seviyesi" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="PopoverVolBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#288B5CF6" CornerRadius="7" Padding="8,2">
                                        <TextBlock x:Name="TxtPopoverVolumeBadge" Text="%100" FontSize="11.5" FontWeight="Bold" Foreground="#E9D5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Slider x:Name="SliderPopoverUserVolume" Minimum="0" Maximum="200" StepFrequency="5" Value="100"
                                        ValueChanged="SliderPopoverUserVolume_ValueChanged" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource RunaCleanButtonStyle}" Content="%0" FontSize="11" FontWeight="SemiBold" Height="28" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#E2E8F0" HorizontalAlignment="Stretch" CornerRadius="8" Click="BtnVolumePreset_Click" Tag="0" />
                                    <Button Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}" Content="%50" FontSize="11" FontWeight="SemiBold" Height="28" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#E2E8F0" HorizontalAlignment="Stretch" CornerRadius="8" Click="BtnVolumePreset_Click" Tag="50" />
                                    <Button Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}" Content="%100" FontSize="11" FontWeight="SemiBold" Height="28" Background="#268B5CF6" BorderBrush="#4D8B5CF6" BorderThickness="1" Foreground="#EDE9FE" HorizontalAlignment="Stretch" CornerRadius="8" Click="BtnVolumePreset_Click" Tag="100" />
                                    <Button Grid.Column="3" Style="{StaticResource RunaCleanButtonStyle}" Content="%150" FontSize="11" FontWeight="SemiBold" Height="28" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#FDE68A" HorizontalAlignment="Stretch" CornerRadius="8" Click="BtnVolumePreset_Click" Tag="150" />
                                    <Button Grid.Column="4" Style="{StaticResource RunaCleanButtonStyle}" Content="%200" FontSize="11" FontWeight="SemiBold" Height="28" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#FCA5A5" HorizontalAlignment="Stretch" CornerRadius="8" Click="BtnVolumePreset_Click" Tag="200" />
                                </Grid>

                                <TextBlock x:Name="TxtPopoverBoostHint" Visibility="Collapsed"
                                           Text="Ses yükseltici açık — kulak koruyucu tavan sınırlayıcı devrede"
                                           FontSize="10.5" Foreground="#FBBF24" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- SES İŞLEME AYARLARI -->
                        <Border CornerRadius="14" Padding="14,8,14,12" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="TglPopoverLocalMute" Header="Benim için sustur" OffContent="Açık" OnContent="Susturuldu"
                                              Toggled="TglPopoverLocalMute_Toggled" />
                                <ToggleSwitch x:Name="TglPopoverClarityBoost" Header="Ses netleştirici (tiz vurgusu + bas kesici)" OffContent="Kapalı" OnContent="Açık"
                                              Toggled="TglPopoverClarityBoost_Toggled" />
                                <ToggleSwitch x:Name="TglPopoverLevelingIncluded" Header="Ses dengelemeye dahil" OffContent="Hariç" OnContent="Dahil"
                                              Toggled="TglPopoverLevelingIncluded_Toggled" />
                                <TextBlock x:Name="TxtPopoverLevelingGain" Text="Dengeleme kazancı: 0.0 dB" FontSize="10.5" Foreground="#94A3B8" Margin="0,-2,0,4" />
                                <Border Height="1" Background="#14FFFFFF" Margin="0,4,0,6" />
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="3B uzamsal konum" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                        <TextBlock x:Name="TxtPopoverSpatialInfo" Text="Otomatik / Merkez" FontSize="10.5" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Button x:Name="BtnPopoverOpenSpatial" Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}"
                                            Content="Düzenle" FontSize="11" FontWeight="SemiBold" Height="28" Padding="12,0" Background="#268B5CF6" BorderBrush="#4D8B5CF6" BorderThickness="1"
                                            Foreground="#EDE9FE" CornerRadius="8" Click="BtnPopoverOpenSpatial_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 4. SES PANELİ (SOUNDPAD) AÇILIR PENCERESİ                         -->
        <!-- ================================================================= -->
        <Grid x:Name="SoundpadModalOverlay" Background="#66000000" Visibility="Collapsed" Tapped="BackdropCloseSoundpad_Tapped">
            <Border x:Name="SoundpadModalCard" Width="460" MaxHeight="520" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,86" Padding="18" Tapped="StopPropagation_Tapped">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Ellipse Width="26" Height="26" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="SoundpadModalHeaderBrush" ImageSource="Assets/soundpad-icon.jpg" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="Runa Ses Paneli (Soundpad)" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Content="+ Özel Ses Ekle" FontSize="11.5" FontWeight="SemiBold"
                                    Background="#288B5CF6" Foreground="#EDE9FE" Height="28" CornerRadius="8" Padding="10,0" Click="BtnAddCustomSound_Click" />
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Content="⏹ Durdur" FontSize="11.5" FontWeight="SemiBold"
                                    Background="#33EF4444" Foreground="#FCA5A5" Height="28" CornerRadius="8" Padding="10,0" Click="BtnStopAllSounds_Click" />
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Width="28" Height="28" CornerRadius="7" Background="Transparent" Click="BtnCloseSoundpad_Click">
                                <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="TxtSoundpadSearch" Grid.Row="1" Style="{StaticResource RunaModalTextBoxStyle}"
                             Height="38" MinHeight="38" PlaceholderText="Ses efekti ara..." Margin="0,0,0,10"
                             TextChanged="TxtSoundpadSearch_TextChanged" />

                    <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater x:Name="SoundpadRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="132" MinRowSpacing="8" MinColumnSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomSoundItem">
                                    <Button Style="{StaticResource RunaCleanButtonStyle}" HorizontalAlignment="Stretch" Height="56" CornerRadius="12"
                                            Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                                            Loaded="InteractiveCard_Loaded"
                                            Click="BtnPlaySoundpadItem_Click" Tag="{x:Bind}">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Emoji}" FontSize="16" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="112" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="12" Padding="12,8" Margin="0,12,0,0">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="TxtSoundpadVolLabel" Text="Ses Paneli Düzeyi: %85" FontSize="11.5" Foreground="#CBD5E1" />
                                <Slider x:Name="SliderSoundpadVol" Minimum="10" Maximum="150" Value="85" ValueChanged="SliderSoundpadVol_ValueChanged" />
                            </StackPanel>
                            <CheckBox x:Name="ChkSoundpadBroadcast" Grid.Column="1" Content="Odadakilere Dinlet" IsChecked="True"
                                      VerticalAlignment="Center" Checked="ChkSoundpadBroadcast_Changed" Unchecked="ChkSoundpadBroadcast_Changed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 5. MODAL: YENİ ODA BAŞLAT (p2p-ana-sayfa-create.png İLE BİREBİR)  -->
        <!-- ================================================================= -->
        <Grid x:Name="HostRoomModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseModals_Tapped">
            <Border x:Name="HostModalDialog" Width="440" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="StopPropagation_Tapped">
                <StackPanel>

                    <!-- HEADER -->
                    <Border Padding="22,18" Background="#05FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" CornerRadius="22,22,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#33A855F7" VerticalAlignment="Center">
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#C084FC" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M12,5 L12,19 M5,12 L19,12" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Yeni Oda Başlat" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="BtnCloseHostModal" Style="{StaticResource RunaCleanButtonStyle}"
                                    Width="28" Height="28" CornerRadius="6" Background="Transparent"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseModals_Click">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#94A3B8" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M18,6 L6,18 M6,6 L18,18" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <StackPanel Padding="22,20" Spacing="16">

                        <!-- 1. ODA KODUNUZ -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="ODA KODUNUZ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="55" />
                            <Border Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                <Grid>
                                    <TextBlock x:Name="TxtGeneratedCode" Text="RUNA-3038" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                               Foreground="#C084FC" CharacterSpacing="95" VerticalAlignment="Center" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                        <!-- Yeni Kod Üret (Kare İkon Buton) -->
                                        <Button x:Name="BtnRefreshCode" Style="{StaticResource RunaCleanButtonStyle}"
                                                Width="32" Height="32" CornerRadius="8"
                                                Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                ToolTipService.ToolTip="Yeni Kod Üret" Click="BtnRefreshCode_Click">
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Polyline Points="23,4 23,10 17,10" Stroke="#CBD5E1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Polyline Points="1,20 1,14 7,14" Stroke="#CBD5E1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <Path Stroke="#CBD5E1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M3.51,9 A9,9 0 0,1 18.36,5.64 L23,10 M1,14 L5.64,18.36 A9,9 0 0,0 20.49,15" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>

                                        <!-- Kodu Kopyala (Kare İkon Buton) -->
                                        <Button x:Name="BtnCopyHostCode" Style="{StaticResource RunaCleanButtonStyle}"
                                                Width="32" Height="32" CornerRadius="8"
                                                Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                ToolTipService.ToolTip="Kodu Kopyala" Click="BtnCopyHostCode_Click">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox x:Name="IconHostCopyNormal" Width="15" Height="15" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="#CBD5E1" StrokeThickness="2" StrokeLineJoin="Round"
                                                              Data="M9,9 H20 A2,2 0 0,1 22,11 V20 A2,2 0 0,1 20,22 H9 A2,2 0 0,1 7,20 V11 A2,2 0 0,1 9,9 Z M5,15 H4 A2,2 0 0,1 2,13 V4 A2,2 0 0,1 4,2 H13 A2,2 0 0,1 15,4 V5" />
                                                    </Canvas>
                                                </Viewbox>
                                                <Viewbox x:Name="IconHostCopyCheck" Width="15" Height="15" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Polyline Points="20,6 9,17 4,12" Stroke="#4ADE80" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 2. KALICI ODA OLARAK KAYDET (Görseldekiyle Birebir Özel Onay Kutusu) -->
                        <StackPanel Spacing="8">
                            <Button x:Name="BtnTogglePermanentCheckbox" Style="{StaticResource RunaCleanButtonStyle}"
                                    HorizontalAlignment="Left" Background="Transparent" Padding="0,2"
                                    Click="BtnTogglePermanentCheckbox_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Border x:Name="PermanentCheckboxBox" Width="17" Height="17" CornerRadius="4"
                                            Background="#0DFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1.5" VerticalAlignment="Center">
                                        <Viewbox x:Name="PermanentCheckboxTick" Width="11" Height="11" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Polyline Points="20,6 9,17 4,12" Stroke="#0A0A0A" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Viewbox Width="13.5" Height="13.5" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FBBF24" Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Kalıcı Oda Olarak Kaydet" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBox x:Name="TxtPermanentTitle" Style="{StaticResource RunaModalTextBoxStyle}"
                                     PlaceholderText="Oda Adı (Örn: Dostlar Meclisi, Oyun Odası)" MaxLength="32" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- 3. PROFİL BİLGİLERİNİZ (48x48 Dairesel Avatar + Mor Kamera Rozeti + İsim Kutusu) -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="PROFİL BİLGİLERİNİZ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="55" />
                            <Border Background="#06FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
