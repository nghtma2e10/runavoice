                                                        <!-- 3.5 kHz -->
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="6">
                                                            <Slider x:Name="SlEq35k" Orientation="Vertical" Height="110" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="3" ValueChanged="SliderEqBand_ValueChanged" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtEq35k" Text="3.5 kHz&#x0a;+3.0 dB" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                                        </StackPanel>
                                                        <!-- 8 kHz -->
                                                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="6">
                                                            <Slider x:Name="SlEq8k" Orientation="Vertical" Height="110" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="2" ValueChanged="SliderEqBand_ValueChanged" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="TxtEq8k" Text="8 kHz&#x0a;+2.0 dB" FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bölüm 4: Ses Dengeleme (Yeni) -->
                                    <StackPanel x:Name="SecVoiceLeveling" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Ses Dengeleme" />
