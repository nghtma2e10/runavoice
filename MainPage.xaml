                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Ekran Üstü Çizim" />
                                        </StackPanel>

                                        <Border Style="{StaticResource SetPanel}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
