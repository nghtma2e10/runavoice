                                                        <ComboBoxItem Content="Hafif" Tag="light" />
                                                        <ComboBoxItem Content="Normal (Varsayılan)" Tag="normal" />
                                                        <ComboBoxItem Content="Güçlü" Tag="strong" />
                                                    </ComboBox>
                                                </Grid>

                                                <Expander Header="Gelişmiş dengeleme seçenekleri" HorizontalAlignment="Stretch" IsExpanded="False" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" CornerRadius="8">
                                                    <Grid Style="{StaticResource SetCardRow}" ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="6,10">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource SetCardRowTitle}" FontSize="12.5" Text="Hedef Konuşma Seviyesi" />
                                                            <TextBlock Style="{StaticResource SetCardRowDesc}" Text="Normalizasyon referans ses seviyesi (dBFS)" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="CmbVoiceLevelingTarget" Grid.Column="1" Width="200" CornerRadius="6" VerticalAlignment="Center" SelectionChanged="CmbVoiceLevelingTarget_SelectionChanged">
