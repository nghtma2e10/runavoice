                                                                <ComboBoxItem Content="2.5 ms (Minimum Gecikme)" Tag="2.5" />
                                                            </ComboBox>
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

