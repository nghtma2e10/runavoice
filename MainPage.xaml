                                        <TextBlock Text="Odadaki katılımcılar sizi bu isim ve fotoğrafla görür." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <!-- FOOTER -->
                    <Border Padding="22,14" Background="#05FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,22,22">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelHostModal" Style="{StaticResource RunaCleanButtonStyle}"
                                    Content="Vazgeç" Height="38" Padding="16,0" CornerRadius="10"
                                    Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    Foreground="#94A3B8" FontSize="12.5" FontWeight="SemiBold"
                                    Click="CloseModals_Click" />

                            <Button x:Name="BtnStartAndJoin" Style="{StaticResource RunaCleanButtonStyle}"
                                    Height="38" Padding="18,0" CornerRadius="10"
                                    Background="{StaticResource ModalPrimaryHostBrush}"
                                    Click="BtnStartAndJoin_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Text="Odayı Başlat &amp; Katıl" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Polyline Points="9,18 15,12 9,6" Stroke="White" StrokeThickness="2.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 6. MODAL: ODAYA KATIL (p2p-ana-sayfa-join.png İLE BİREBİR AYNI)   -->
        <!-- ================================================================= -->
        <Grid x:Name="JoinRoomModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseModals_Tapped">
            <Border x:Name="JoinModalDialog" Width="440" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="StopPropagation_Tapped">
                <StackPanel>

                    <!-- HEADER -->
                    <Border Padding="22,18" Background="#05FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" CornerRadius="22,22,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#333B82F6" VerticalAlignment="Center">
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="#60A5FA" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M10,13 A5,5 0 0,0 17.54,13.54 L20.54,10.54 A5,5 0 0,0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0,0 6.46,10.46 L3.46,13.46 A5,5 0 0,0 10.53,20.53 L12.24,18.82" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Odaya Katıl" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="BtnCloseJoinModal" Style="{StaticResource RunaCleanButtonStyle}"
                                    Width="28" Height="28" CornerRadius="6" Background="Transparent"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseModals_Click">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#94A3B8" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M18,6 L6,18 M6,6 L18,18" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BODY -->
                    <StackPanel Padding="22,20" Spacing="16">

                        <!-- 1. ODA KODUNU GİRİN -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="ODA KODUNU GİRİN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="55" />
                            <TextBox x:Name="TxtJoinRoomInput" PlaceholderText="RUNA-XXXX"
                                     Height="44" MinHeight="44" CornerRadius="10"
                                     Background="#0CFFFFFF" BorderBrush="#8B5CF6" BorderThickness="1.2"
                                     FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#93C5FD"
                                     Padding="14,8,14,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     TextAlignment="Center" CharacterCasing="Upper" MaxLength="16"
                                     KeyDown="TxtJoinRoomInput_KeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7794A3B8" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6694A3B8" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A855F7" />
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Olmayan / Boş Oda Uyarı Kutusu (Shake Animasyonlu) -->
                        <Border x:Name="JoinErrorBanner" Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="10" Padding="14,10" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="17" Height="17" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="#FCA5A5" StrokeThickness="2.2" />
                                        <Path Stroke="#FCA5A5" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M12,8 L12,12.5 M12,16.5 L12.01,16.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TxtJoinError" Grid.Column="1" Text="Böyle bir oda mevcut değil veya henüz başlatılmamış! Lütfen kodu kontrol edin."
                                           FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. PROFİL BİLGİLERİNİZ -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="PROFİL BİLGİLERİNİZ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="55" />
                            <Border Background="#06FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnJoinAvatarPicker" Grid.Column="0" Style="{StaticResource RunaCleanButtonStyle}"
                                            Width="50" Height="50" Background="Transparent" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Profil Fotoğrafını Değiştir" Click="BtnPickProfileAvatar_Click">
                                        <Grid Width="50" Height="50">
                                            <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#998B5CF6" BorderThickness="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Ellipse Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <ImageBrush x:Name="JoinModalAvatarBrush" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Border>

                                            <Border Width="18" Height="18" CornerRadius="9" Background="#7C3AED" BorderBrush="#0E0B1D" BorderThickness="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Viewbox Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="White" StrokeThickness="2.2" StrokeLineJoin="Round"
                                                              Data="M23,19 A2,2 0 0,1 21,21 H3 A2,2 0 0,1 1,19 V8 A2,2 0 0,1 3,6 H7 L9,3 H15 L17,6 H21 A2,2 0 0,1 23,8 Z" />
                                                        <Ellipse Canvas.Left="8.5" Canvas.Top="9.5" Width="7" Height="7" Stroke="White" StrokeThickness="2.2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBox x:Name="TxtJoinNickname" Style="{StaticResource RunaModalTextBoxStyle}"
                                                 PlaceholderText="Kullanıcı Adınız" MaxLength="24" />
                                        <TextBlock Text="Odaya bağlanırken bu isim ve avatar kullanılacaktır." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <!-- FOOTER -->
                    <Border Padding="22,14" Background="#05FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,22,22">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelJoinModal" Style="{StaticResource RunaCleanButtonStyle}"
                                    Content="Vazgeç" Height="38" Padding="16,0" CornerRadius="10"
                                    Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    Foreground="#94A3B8" FontSize="12.5" FontWeight="SemiBold"
                                    Click="CloseModals_Click" />

                            <Button x:Name="BtnSubmitJoin" Style="{StaticResource RunaCleanButtonStyle}"
                                    Height="38" Padding="18,0" CornerRadius="10"
                                    Background="{StaticResource ModalPrimaryJoinBrush}"
                                    Click="BtnSubmitJoin_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSubmitJoinLabel" Text="Odaya Katıl" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Polyline Points="9,18 15,12 9,6" Stroke="White" StrokeThickness="2.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 7. MODAL: MODERN EKRAN VE PENCERE SEÇİCİ (4x3 IZGARA, KATLANABİLİR KALİTE) -->
        <!-- ================================================================= -->
        <Grid x:Name="ScreenPickerModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseScreenPicker_Tapped">
            <Border x:Name="ScreenPickerModalCard" Width="950" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Padding="22" Tapped="StopPropagation_Tapped"
                    SizeChanged="ScreenPickerModalCard_SizeChanged">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!-- Üst Başlık ve Yenile / Kapat -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtScreenPickerTitle" Text="Ekran veya Uygulama Penceresi Paylaş" FontSize="17" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Paylaşmak istediğiniz ekranı veya pencereyi seçin ve yayın kalitesini belirleyin" FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Content="↻ Yenile" FontSize="11.5" FontWeight="SemiBold"
                                    Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Foreground="#E2E8F0"
                                    Height="30" Padding="12,0" CornerRadius="8" Click="BtnRefreshCaptureSources_Click" />
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Width="30" Height="30" CornerRadius="8" Background="Transparent" Click="BtnCloseScreenPicker_Click">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- SEKME BUTONLARI & KAYAN GÖSTERGE -->
                    <Border Grid.Row="1" Background="#120D24" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12">
                        <Grid x:Name="PickerTabContainer" SizeChanged="PickerTabContainer_SizeChanged">
                            <!-- Kayan Gösterge (Mor yarı saydam, köşe 9) -->
                            <Border x:Name="PickerTabIndicator"
                                    HorizontalAlignment="Left"
                                    Height="36"
                                    CornerRadius="9"
                                    Background="#2E8B5CF6"
                                    BorderBrush="#598B5CF6"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />

                            <Grid ColumnDefinitions="*,*">
                                <Button x:Name="BtnTabScreens" Grid.Column="0" Style="{StaticResource RunaCleanButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="36" CornerRadius="9"
                                        Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                        Click="BtnTabScreens_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖥️  Tüm Ekranlar" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTabScreensCount" Text="1" FontSize="11" FontWeight="Bold" Foreground="#DDD6FE" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnTabWindows" Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="36" CornerRadius="9"
                                        Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12.5"
                                        Click="BtnTabWindows_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🪟  Uygulama Pencereleri" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTabWindowsCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Kaynaklar Izgarası (Dış ScrollViewer kaldırıldı, GridView doğrudan Grid satırında) -->
                    <GridView x:Name="ScreenSourcesGridView" Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="ScreenSourcesGridView_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Center">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid 
                                               Orientation="Horizontal"
                                               MaximumRowsOrColumns="4"
                                               ItemWidth="226"
                                               ItemHeight="200"
                                               HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="RootGrid" CornerRadius="12">
                                                <Border x:Name="SelectionGlow" CornerRadius="12" BorderThickness="2" BorderBrush="#8B5CF6" Opacity="0" />
                                                <ContentPresenter x:Name="ContentPresenter" Margin="0" />
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="0.4" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="0.6" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Unselected" />
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="1.0" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedUnfocused">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="0.8" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="1.0" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="SelectionGlow.Opacity" Value="1.0" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScreenCaptureSourceItem">
                                <Border Width="214" Height="188" Padding="8" CornerRadius="12" Background="#161129" BorderBrush="#2E8B5CF6" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <!-- Küçük Resim (214x120, 16:9) -->
                                        <Border Height="120" CornerRadius="8" Background="#07050E" BorderBrush="#22FFFFFF" BorderThickness="1">
                                            <Grid CornerRadius="8">
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="{x:Bind ThumbnailStretch, Mode=OneWay}" />
                                                <!-- Küçültülmüş pencereler için sağ üstte Simge Durumunda rozeti -->
                                                <Border Visibility="{x:Bind IsMinimized, Mode=OneWay}"
                                                        Background="#D91E163B" BorderBrush="#408B5CF6" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                    <TextBlock Text="Simge durumunda" FontSize="9.5" FontWeight="SemiBold" Foreground="#DDD6FE" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                            <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasAppIcon, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Katlanabilir Yayın Kalitesi ve Ayarları Kartı -->
                    <Border Grid.Row="3" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,10,0,10">
                        <StackPanel Spacing="8">
                            <!-- Katlanabilir Başlık Butonu -->
                            <Button x:Name="BtnToggleQualityCard" Style="{StaticResource RunaCleanButtonStyle}"
                                    HorizontalAlignment="Stretch" Background="Transparent" Click="BtnToggleQualityCard_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️  Yayın Kalitesi" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtQualityChevron" Text="▾" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtQualitySummary" Text="1080p · 60 FPS · Dinamik: Açık" FontSize="11.5" Foreground="#A78BFA"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Açılır/Kapanır Detay Ayarları -->
                            <StackPanel x:Name="QualitySettingsPanel" Spacing="10" Visibility="Collapsed" Margin="0,6,0,0">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock x:Name="TxtPickerResLabel" Text="MAKSİMUM ÇÖZÜNÜRLÜK" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <ComboBox x:Name="CmbPickerResolution" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="PickerSetting_Changed">
                                            <ComboBoxItem Content="720p HD (Çok Akıcı)" Tag="720" />
                                            <ComboBoxItem Content="1080p Full HD" Tag="1080" />
                                            <ComboBoxItem Content="1440p 2K QHD" Tag="1440" />
                                            <ComboBoxItem Content="2160p 4K UHD" Tag="2160" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="TxtPickerFpsLabel" Text="MAKSİMUM KARE HIZI (FPS)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <ComboBox x:Name="CmbPickerFps" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="PickerSetting_Changed">
                                            <ComboBoxItem Content="30 FPS (Dengeli)" Tag="30" />
                                            <ComboBoxItem Content="60 FPS (Yüksek Akıcılık)" Tag="60" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="YAYIN MOTORU / CODEC" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <ComboBox x:Name="CmbPickerCodec" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="PickerSetting_Changed">
                                            <ComboBoxItem Content="MJPEG (JPEG Kareleri - Aktif)" Tag="mjpeg" />
                                            <ComboBoxItem Content="AV1 (yakında)" Tag="av1" IsEnabled="False" />
                                            <ComboBoxItem Content="H.265 / HEVC (yakında)" Tag="h265" IsEnabled="False" />
                                            <ComboBoxItem Content="H.264 (yakında)" Tag="h264" IsEnabled="False" />
                                        </ComboBox>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkPickerDataSaver" Grid.Column="3" Content="Veri Tasarrufu" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                </Grid>

                                <!-- Dinamik Çözünürlük ve Kalite Önceliği -->
                                <Border Height="1" Background="#14FFFFFF" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <ToggleSwitch x:Name="TglPickerAdaptive" Header="Dinamik Çözünürlük"
                                                      OffContent="Sabit Kalite" OnContent="Otomatik Uyarlanabilir"
                                                      Toggled="TglPickerAdaptive_Toggled" />
                                        <TextBlock Text="İnternet bağlantınıza göre çözünürlük ve kalite otomatik ayarlanır. Seçtiğiniz çözünürlük ve FPS üst sınır olarak kullanılır."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" MinWidth="220">
                                        <TextBlock Text="ÖNCELİK MODU" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <ComboBox x:Name="CmbPickerAdaptivePriority" HorizontalAlignment="Stretch" SelectedIndex="0"
                                                  SelectionChanged="CmbPickerAdaptivePriority_SelectionChanged">
                                            <ComboBoxItem Content="🎯 Netlik (Yazı, Sunum)" Tag="clarity" />
                                            <ComboBoxItem Content="⚡ Akıcılık (Oyun, Video)" Tag="motion" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Alt Çubuk: Seçili Kaynak Bilgisi ve Aksiyon Butonları -->
                    <Grid Grid.Row="4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSelectedSourceHint" Grid.Column="0" Text="Kaynak seçildi, yayına hazır." FontSize="12" Foreground="#C4B5FD" VerticalAlignment="Center" />
                        <Button x:Name="BtnPickerStopStream" Grid.Column="1" Style="{StaticResource RunaCleanButtonStyle}"
                                Content="🛑 Yayını Durdur" Height="38" Padding="14,0" CornerRadius="10"
                                Background="#DC2626" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                Visibility="Collapsed"
                                Click="BtnPickerStopStream_Click" />
                        <Button x:Name="BtnCancelScreenPicker" Grid.Column="2" Style="{StaticResource RunaCleanButtonStyle}"
                                Content="Vazgeç" Height="38" Padding="18,0" CornerRadius="10"
                                Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="#94A3B8" FontSize="12.5" FontWeight="SemiBold"
                                Click="BtnCloseScreenPicker_Click" />
                        <Button x:Name="BtnConfirmStartStream" Grid.Column="3" Style="{StaticResource RunaCleanButtonStyle}"
                                Content="🔴 Yayını Başlat" Height="38" Padding="20,0" CornerRadius="10"
                                Background="{StaticResource ModalPrimaryHostBrush}" Foreground="White" FontSize="13" FontWeight="Bold"
                                Click="BtnConfirmStartStream_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<!-- 7.C MODAL: YENİ ANKET OLUŞTUR                                     -->
        <!-- ================================================================= -->
        <Grid x:Name="CreatePollModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseCreatePoll_Tapped">
            <Border Width="440" CornerRadius="22" Background="#0E0B1D" BorderBrush="#598B5CF6" BorderThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Tapped="StopPropagation_Tapped">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#268B5CF6" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Yeni Anket Oluştur" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource RunaCleanButtonStyle}" Width="30" Height="30" CornerRadius="8" Background="Transparent"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCloseCreatePoll_Click">
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#94A3B8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,6 L6,18 M6,6 L18,18" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ANKET SORUSU" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtPollQuestion" Style="{StaticResource RunaModalTextBoxStyle}" PlaceholderText="Örn: Yeni oda adı ne olsun?" MaxLength="80" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="1. SEÇENEK" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtPollOption1" Style="{StaticResource RunaModalTextBoxStyle}" PlaceholderText="Örn: Runa Lounge" MaxLength="40" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="2. SEÇENEK" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBox x:Name="TxtPollOption2" Style="{StaticResource RunaModalTextBoxStyle}" PlaceholderText="Örn: Runa Chill" MaxLength="40" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="ANKET SÜRESİ" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" />
                        <ComboBox x:Name="CmbPollDuration" HorizontalAlignment="Stretch" SelectedIndex="3"
                                  Background="#16FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
                            <ComboBoxItem Content="15 dakika" Tag="15 dakika içinde sona erecek" />
                            <ComboBoxItem Content="30 dakika" Tag="30 dakika içinde sona erecek" />
                            <ComboBoxItem Content="1 saat" Tag="1 saat içinde sona erecek" />
                            <ComboBoxItem Content="2 saat" Tag="2 saat içinde sona erecek" IsSelected="True" />
                            <ComboBoxItem Content="6 saat" Tag="6 saat içinde sona erecek" />
                            <ComboBoxItem Content="24 saat" Tag="24 saat içinde sona erecek" />
                            <ComboBoxItem Content="Süresiz" Tag="Süresiz anket" />
                        </ComboBox>
                    </StackPanel>

                    <Border Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Content="Vazgeç" Height="38" Padding="18,0" CornerRadius="10"
                                    Background="Transparent" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="#94A3B8" FontSize="12.5" FontWeight="SemiBold"
                                    Click="BtnCloseCreatePoll_Click" />
                            <Button Style="{StaticResource RunaCleanButtonStyle}" Content="📊 Anketi Başlat" Height="38" Padding="20,0" CornerRadius="10"
                                    Background="{StaticResource ModalPrimaryHostBrush}" Foreground="White" FontSize="13" FontWeight="Bold"
                                    Click="BtnSubmitCreatePoll_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 8. KAPSAMLI AYARLAR PENCERESİ (Electron "Yeni Nesil Ayarlar" düzeni) -->
        <!--    Sol: arama + profil kartı + akordiyon kategoriler + sürüm kartı  -->
        <!--    Sağ: başlık çubuğu + bölüm çapalı kaydırılabilir içerik           -->
        <!-- ================================================================= -->
        <Grid x:Name="SettingsModalOverlay" Background="#C704030A" Visibility="Collapsed" Tapped="BackdropCloseSettings_Tapped">
            <Grid.Resources>
                <Style x:Key="SetAnchorIcon" TargetType="FontIcon">
                    <Setter Property="Glyph" Value="&#xE71B;" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="#80848E" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetAnchorTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#F2F3F5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#F2F3F5" />
                </Style>
                <Style x:Key="SetDesc" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Foreground" Value="#949BA4" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="SetRowTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#F2F3F5" />
                </Style>
                <Style x:Key="SetSubLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#CBD5E1" />
                </Style>
                <Style x:Key="SetSubHint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10.5" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <!-- RNNoise tarzı mor çerçeveli degrade panel -->
                <Style x:Key="SetPanel" TargetType="Border">
                    <Setter Property="BorderBrush" Value="#478B5CF6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="Padding" Value="18,16" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F5121216" Offset="0" />
                                <GradientStop Color="#F50E101A" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="SetPlainCard" TargetType="Border">
                    <Setter Property="Background" Value="#1E1F22" />
                    <Setter Property="BorderBrush" Value="#12FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="16" />
                </Style>
                <Style x:Key="SetToggleRow" TargetType="Border">
                    <Setter Property="Background" Value="#08FFFFFF" />
                    <Setter Property="BorderBrush" Value="#0FFFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="14,10" />
                </Style>
                <Style x:Key="SetInset" TargetType="Border">
                    <Setter Property="Background" Value="#0D0E12" />
                    <Setter Property="BorderBrush" Value="#12FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="12,10" />
                </Style>
                <Style x:Key="SetIconTile" TargetType="Border">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Background" Value="#2E792FFF" />
                    <Setter Property="BorderBrush" Value="#59A56BFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetIconTileText" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="17" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetPanelTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Style>
                <Style x:Key="SetPanelSub" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                </Style>
                <Style x:Key="SetBadge" TargetType="Border">
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Padding" Value="9,4" />
                    <Setter Property="MinHeight" Value="22" />
                    <Setter Property="Background" Value="#2400E5FF" />
                    <Setter Property="BorderBrush" Value="#6600E5FF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
                <Style x:Key="SetBadgeGreen" TargetType="Border" BasedOn="{StaticResource SetBadge}">
                    <Setter Property="Background" Value="#1F22C55E" />
                    <Setter Property="BorderBrush" Value="#5922C55E" />
                </Style>
                <Style x:Key="SetBadgeAmber" TargetType="Border" BasedOn="{StaticResource SetBadge}">
                    <Setter Property="Background" Value="#24F59E0B" />
                    <Setter Property="BorderBrush" Value="#66F59E0B" />
                </Style>
                <Style x:Key="SetBadgeText" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="ExtraBold" />
                    <Setter Property="Foreground" Value="#00E5FF" />
                    <Setter Property="CharacterSpacing" Value="60" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="LineHeight" Value="12" />
                    <Setter Property="TextLineBounds" Value="Tight" />
                </Style>
                <Style x:Key="SetKbd" TargetType="Border">
                    <Setter Property="Background" Value="#1E1F22" />
                    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetKbdText" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#C4B5FD" />
                </Style>

                <!-- Windows 11 Ayarlar Tarzı Kompakt Satır Stilleri -->
                <Style x:Key="SetCardRow" TargetType="Grid">
                    <Setter Property="MinHeight" Value="52" />
                </Style>
                <Style x:Key="SetCardRowTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="SetCardRowDesc" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="0,1,0,0" />
                </Style>
                <Style x:Key="SetCardRowDivider" TargetType="Border">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Background" Value="#0FFFFFFF" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
                <Style x:Key="SetHotkeyRow" TargetType="Border">
                    <Setter Property="BorderBrush" Value="#0FFFFFFF" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="4,12" />
                </Style>
                <Style x:Key="SetPill" TargetType="Button" BasedOn="{StaticResource RunaCleanButtonStyle}">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style x:Key="SetSwitch" TargetType="ToggleSwitch">
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <Border x:Name="SettingsModalCard" MaxWidth="1220" MaxHeight="960" Margin="32" CornerRadius="14" Background="#18191C" BorderBrush="#14FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tapped="StopPropagation_Tapped">
                <Grid ColumnDefinitions="270,*">

                    <!-- SOL KENAR ÇUBUĞU -->
                    <Border Grid.Column="0" Background="#111214" CornerRadius="14,0,0,14" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" Padding="10,14,10,18">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">

                            <!-- Arama Çubuğu -->
                            <Grid Grid.Row="0">
                                <TextBox x:Name="TxtSettingsSearch" PlaceholderText="Ayarları ara..." FontSize="13" Padding="32,6,10,6" MinHeight="34"
                                         Background="#1E1F22" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6" Foreground="#DBDEE1"
                                         TextChanged="TxtSettingsSearch_TextChanged" />
                                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="#72767D" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <!-- Kullanıcı Kartı -->
                            <Border Grid.Row="1" Margin="0,12,0,8" Padding="10,8" CornerRadius="8" Background="#08FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <Ellipse Fill="#2B2D31" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="SettingsSidebarAvatarBrush" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="11" Height="11" Fill="#23A55A" Stroke="#111214" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsSidebarName" Text="Kullanıcı" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TxtSettingsSidebarSub" Text="Çevrimiçi" FontSize="11" Foreground="#949BA4" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Akordiyon Kategori Menüsü (kod tarafında oluşturulur: BuildSettingsNav) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SettingsNavHost" Spacing="2" Padding="0,0,2,8" />
                            </ScrollViewer>

                            <!-- Uygulama Bilgisi / Sürüm Kartı -->
                            <Border Grid.Row="3" Margin="0,10,0,0" Padding="14,12" CornerRadius="10" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border CornerRadius="4" Padding="6,2" Background="#2E10B981" BorderBrush="#5910B981" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="STABLE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#34D399" CharacterSpacing="60" />
                                        </Border>
                                        <TextBlock Text="RUNA Voice &amp; Stage" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSettingsAppVersion" Text="Sürüm 1.0.0 (WinUI 3 Native)" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource RunaCleanButtonStyle}" Content="Güncellemeleri denetle"
                                            Background="#1E1F22" BorderBrush="#2EFFFFFF" BorderThickness="1" Foreground="#C4B5FD"
                                            FontSize="11" Height="28" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                            Click="BtnCheckUpdate_Click" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                                        <TextBlock Text="RNNoise C • Opus 48kHz • P2P SRTP" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SAĞ İÇERİK ALANI -->
                    <Grid Grid.Column="1" RowDefinitions="56,*">
                        <Grid Grid.Row="0" Padding="28,0" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSettingsPaneTitle" Text="Ses Ayarları" FontSize="16" FontWeight="Bold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="#80848E" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BtnSettingsClose" Style="{StaticResource RunaCleanButtonStyle}" Width="32" Height="32" CornerRadius="16"
                                    Background="Transparent" BorderBrush="#1AFFFFFF" BorderThickness="1" Foreground="#B5BAC1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Kapat (Esc)" Click="BtnCloseSettings_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>

                        <ScrollViewer x:Name="SettingsContentScroller" Grid.Row="1" Padding="32,24,32,48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>

                                <!-- ======================= GÖRÜNÜM ======================= -->
                                <StackPanel x:Name="PaneSettingsAppearance" Spacing="28" Visibility="Collapsed">
                                    <StackPanel x:Name="SecAppProfile" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
                                            <TextBlock Style="{StaticResource SetAnchorTitle}" Text="Kullanıcı Profili" />
                                        </StackPanel>
                                        <Border Style="{StaticResource SetPlainCard}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                                                <Grid Width="72" Height="72" VerticalAlignment="Center">
                                                    <Ellipse Fill="#2B2D31" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush x:Name="SettingsAvatarBrush" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="8" MaxWidth="380" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource SetLabel}" Text="Görünen Ad" />
                                                    <TextBox x:Name="TxtSettingsProfileName" CornerRadius="6" TextChanged="TxtSettingsProfileName_TextChanged" />
                                                    <Button Style="{StaticResource RunaCleanButtonStyle}" Content="📷 Bilgisayardan Fotoğraf Yükle" HorizontalAlignment="Left"
                                                            Background="#248B5CF6" BorderBrush="#4D8B5CF6" BorderThickness="1" Foreground="White" Height="32" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                                                            CornerRadius="6" Click="BtnPickProfileAvatar_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="SecAppUi" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Style="{StaticResource SetAnchorIcon}" />
