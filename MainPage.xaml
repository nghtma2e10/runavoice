                                                <!-- 1. Anahtar: İzleyiciler ekranıma çizebilsin -->
                                                <Border Style="{StaticResource SetToggleRow}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource SetRowTitle}" Text="İzleyiciler ekranıma çizebilsin" />
                                                            <TextBlock Style="{StaticResource SetDesc}" Text="Açıldığında odadaki katılımcılar yayınlanan ekranınızın üstüne anlık çizim yapabilir." Margin="0,2,0,0" />
                                                        </StackPanel>
